---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { buildCategoryTree } from '../../lib/utils';
import { base, getCategoryDisplayKo } from '../../lib/config';
import { getPublishedPosts } from '../../lib/posts';
const posts = await getPublishedPosts();
const categoryTree = buildCategoryTree(posts.map(p => p.data.category));
const sortedParents = [...categoryTree.entries()].sort((a, b) => b[1].count - a[1].count);
const catDisplayKo = getCategoryDisplayKo();
---

<BaseLayout title="카테고리 — IT Oasis">
  <h1 class="text-[28px] sm:text-[32px] font-bold leading-[1.3] tracking-[-0.02em]">카테고리</h1>
  <p class="mt-2 text-[14.5px] text-gray-500 dark:text-gray-400">{sortedParents.length}개</p>

  <ul class="mt-8 m-0 p-0 list-none">
    {sortedParents.map(([parent, node]) => (
      <li class="py-3">
        <a href={`${base}/categories/${encodeURIComponent(parent)}`} class="post-row-title">
          {catDisplayKo.get(parent) || parent} <span class="font-normal text-gray-500 dark:text-gray-400 tabular-nums">{node.count}</span>
        </a>
        {node.children.size > 0 && (
          <p class="post-row-desc">
            {[...node.children.entries()].sort((a, b) => b[1].count - a[1].count).map(([child, childNode]) => `${catDisplayKo.get(child) || child} ${childNode.count}`).join(' · ')}
          </p>
        )}
      </li>
    ))}
  </ul>
</BaseLayout>
