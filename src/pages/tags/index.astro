---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { base } from '../../lib/config';
import { getPublishedPosts } from '../../lib/posts';
import { TOPICS } from '../../data/topics';
const posts = await getPublishedPosts();
const tagMap = new Map<string, number>();

posts.forEach((post) => {
  post.data.tags.forEach((tag) => {
    tagMap.set(tag, (tagMap.get(tag) || 0) + 1);
  });
});

const tags = [...tagMap.entries()].sort((a, b) => b[1] - a[1]);

// 주제는 정해 둔 열 개, 태그는 글마다 자유롭게 붙인 말이다. 주제를 위에 둔다.
const topics = TOPICS.map((t) => ({
  ...t,
  count: posts.filter((p) => (p.data.topics as string[]).includes(t.id)).length,
}));
---

<BaseLayout title="주제와 태그 — IT Oasis">
  <h1 class="text-[28px] sm:text-[32px] font-bold leading-[1.3] tracking-[-0.02em]">주제와 태그</h1>

  <h2 class="mt-10 mb-3 text-[14px] font-bold text-gray-500 dark:text-gray-400">주제</h2>
  <nav class="text-links" aria-label="주제">
    {topics.map((topic) => (
      <a href={`${base}/topics/${topic.id}`}>{topic.name} <span class="tabular-nums">{topic.count}</span></a>
    ))}
  </nav>

  <h2 class="mt-10 mb-3 text-[14px] font-bold text-gray-500 dark:text-gray-400">태그</h2>
  <nav class="text-links" aria-label="태그">
    {tags.map(([tag, count]) => (
      <a href={`${base}/tags/${encodeURIComponent(tag)}`}>{tag} <span class="tabular-nums">{count}</span></a>
    ))}
  </nav>
</BaseLayout>
