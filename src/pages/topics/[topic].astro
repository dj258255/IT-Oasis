---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PostCard from '../../components/PostCard.astro';
import { base } from '../../lib/config';
import { getPublishedPosts } from '../../lib/posts';
import { TOPICS } from '../../data/topics';

export async function getStaticPaths() {
  const posts = await getPublishedPosts();

  // 주제는 목록이 정해져 있어서 글이 아직 없는 주제도 페이지를 만든다. 글 페이지의 주제 링크가 죽지 않는다.
  return TOPICS.map((topic) => ({
    params: { topic: topic.id },
    props: {
      name: topic.name,
      posts: posts.filter((post) => (post.data.topics as string[]).includes(topic.id)),
    },
  }));
}

const { name, posts } = Astro.props;
---

<BaseLayout title={`${name} — IT Oasis`}>
  <div class="fade-in-up">
    <a href={`${base}/tags`} class="group inline-flex items-center gap-1.5 text-[12px] sm:text-[13px] text-gray-400 dark:text-gray-500 hover:text-primary dark:hover:text-primary-light transition-all duration-300 mb-6 sm:mb-8">
      <svg class="w-3.5 h-3.5 group-hover:-translate-x-1 transition-transform duration-300" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
        <path stroke-linecap="round" stroke-linejoin="round" d="M15 19l-7-7 7-7" />
      </svg>
      <span>모든 주제와 태그</span>
    </a>

    <div class="flex items-center gap-3 mb-2 px-1">
      <h1 class="text-xl sm:text-2xl font-bold tracking-tight">
        <span class="gradient-text">{name}</span>
      </h1>
    </div>
    <p class="text-[12px] sm:text-[13px] text-gray-400 dark:text-gray-500 mb-8 sm:mb-10 px-1">
      {posts.length}<span>개의 글</span>
    </p>
  </div>

  <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-4 sm:gap-5 stagger">
    {posts.map((post: any, i: number) => (
      <PostCard
        title={post.data.title}
        description={post.data.description}
        date={post.data.date}
        slug={post.id}
        tags={post.data.tags}
        topics={post.data.topics}
        coverImage={post.data.coverImage}
        index={i}
      />
    ))}
  </div>
</BaseLayout>
