---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PostList from '../../components/PostList.astro';
import { base } from '../../lib/config';
import { getPublishedPosts } from '../../lib/posts';
import { TOPICS } from '../../data/topics';

export async function getStaticPaths() {
  const posts = await getPublishedPosts();

  // 주제는 목록이 정해져 있어서 글이 아직 없는 주제도 페이지를 만든다. 글 페이지의 주제 링크가 죽지 않는다.
  return TOPICS.map((topic) => ({
    params: { topic: topic.id },
    props: {
      id: topic.id,
      name: topic.name,
      posts: posts.filter((post) => (post.data.topics as string[]).includes(topic.id)),
      counts: TOPICS.map((t) => ({
        id: t.id,
        name: t.name,
        count: posts.filter((p) => (p.data.topics as string[]).includes(t.id)).length,
      })).filter((o) => o.count > 0),
    },
  }));
}

const { id, name, posts, counts } = Astro.props;
---

<BaseLayout title={`${name} — IT Oasis`}>
  <p class="text-[14px] mb-6"><a href={`${base}/blog`} class="text-gray-500 dark:text-gray-400 hover:text-primary hover:underline underline-offset-4">&larr; 모든 글</a></p>

  <h1 class="text-[28px] sm:text-[32px] font-bold leading-[1.3] tracking-[-0.02em]">{name}</h1>
  <p class="mt-2 text-[14.5px] text-gray-500 dark:text-gray-400">{posts.length}편</p>

  <nav class="text-links mt-5" aria-label="주제 고르기">
    <a href={`${base}/blog`}>전체</a>
    {counts.map((o: any) => (
      <a href={`${base}/topics/${o.id}`} class:list={[{ 'is-active': o.id === id }]} aria-current={o.id === id ? 'page' : undefined}>{o.name} {o.count}</a>
    ))}
  </nav>

  <PostList posts={posts} />
</BaseLayout>
