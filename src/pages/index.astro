---
import BaseLayout from '../layouts/BaseLayout.astro';
import PostList from '../components/PostList.astro';
import { projects, projectTypeLabels } from '../data/projects';
import { getFeedPosts } from '../lib/posts';
import { base, getSiteSettings } from '../lib/config';

const siteSettings = getSiteSettings();
const tagline = String(siteSettings.description || '').split('\n')[0];

// 최신 글 = 프로젝트 개발기·사례·일반 글. 프로젝트 목록으로 이미 보이는 소개/회고 글은 뺀다.
const posts = (await getFeedPosts()).slice(0, 12);
const featuredProjects = projects.filter((project) => project.projectType !== 'toy');

const projectHref = (project: (typeof projects)[number]) =>
  project.story
    ? `${base}${project.hub ?? project.story}`
    : (Array.isArray(project.website) ? project.website[0]?.url : project.website) ||
      (Array.isArray(project.github) ? project.github[0]?.url : project.github) ||
      `${base}/projects`;
---

<BaseLayout title={siteSettings.name}>
  <h1 class="text-[28px] sm:text-[32px] font-bold leading-[1.3] tracking-[-0.02em]">{siteSettings.name}</h1>
  <p class="mt-3 text-[16px] sm:text-[17px] leading-[1.7] text-gray-500 dark:text-gray-400">{tagline}</p>

  <section class="mt-12">
    <div class="flex items-baseline justify-between border-b border-[#d1d9e0] dark:border-[#3d444d] pb-2">
      <h2 class="text-[14px] font-bold text-gray-500 dark:text-gray-400">최근 글</h2>
      <a href={`${base}/blog`} class="text-[14px] text-primary hover:underline underline-offset-4">전체 보기</a>
    </div>
    <PostList posts={posts} byYear={false} />
  </section>

  <section class="mt-12">
    <div class="flex items-baseline justify-between border-b border-[#d1d9e0] dark:border-[#3d444d] pb-2">
      <h2 class="text-[14px] font-bold text-gray-500 dark:text-gray-400">프로젝트</h2>
      <a href={`${base}/projects`} class="text-[14px] text-primary hover:underline underline-offset-4">전체 보기</a>
    </div>
    <ul class="m-0 p-0 list-none">
      {featuredProjects.map((project) => (
        <li class="py-3">
          <a href={projectHref(project)} class="post-row-title">{project.title}</a>
          <p class="post-row-desc" style="-webkit-line-clamp: 2">{projectTypeLabels[project.projectType]} &middot; {project.description}</p>
        </li>
      ))}
    </ul>
  </section>
</BaseLayout>
