---
/**
 * 옛 BE-commerce 허브 주소. 영역 지도와 영역별 글은 개요 글로 합쳤다.
 * 정적 호스팅이라 서버 리다이렉트를 못 걸어 페이지에서 넘긴다. 스크립트로 넘겨 #영역 해시를
 * 그대로 가져가고, 스크립트가 꺼진 환경은 meta refresh 가 받는다.
 */
import { base } from '../../lib/config';
import { OVERVIEW_ID } from '../../data/be-commerce-hub';
import { getHubDomains } from '../../lib/hub';

// 이 페이지는 늘 빌드된다. 개요 글이 빌드에서 빠져도 영역 매핑 검사는 여기서 돈다.
await getHubDomains();

const target = `${base}/blog/${OVERVIEW_ID}/`;
const canonical = new URL(target, Astro.site ?? 'https://dj258255.github.io').href;
---

<!doctype html>
<html lang="ko">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>BE-commerce</title>
    <meta name="robots" content="noindex" />
    <link rel="canonical" href={canonical} />
    <script is:inline define:vars={{ target }}>
      location.replace(target + location.hash);
    </script>
    <meta http-equiv="refresh" content={`0; url=${target}`} />
  </head>
  <body>
    <p>BE-commerce 페이지가 옮겨졌습니다. <a href={target}>BE-commerce 개요로 이동</a></p>
  </body>
</html>
