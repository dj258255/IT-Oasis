---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import PostCard from '../../components/PostCard.astro';
import { getPublishedPosts } from '../../lib/posts';
import { base } from '../../lib/config';
import { hubDomains, hubEdges, OVERVIEW_ID } from '../../data/be-commerce-hub';

const REPO_URL = 'https://github.com/dj258255/BE-commerce';
const PREFIX = 'project/be-commerce/';

// 영역 매핑이 글과 어긋나면 빌드를 멈춘다. 새 글이 허브에서 조용히 빠지는 것을 막는다.
const allIds = new Set((await getCollection('blog')).map((p) => p.id));
const published = (await getPublishedPosts()).filter((p) => p.id.startsWith(PREFIX) && p.id !== OVERVIEW_ID);
const publishedById = new Map(published.map((p) => [p.id, p]));

const owner = new Map<string, string>();
for (const domain of hubDomains) {
  for (const id of domain.posts) {
    if (!allIds.has(id)) throw new Error(`be-commerce 허브: 없는 글 id "${id}" (영역 ${domain.id})`);
    if (owner.has(id)) throw new Error(`be-commerce 허브: "${id}"가 ${owner.get(id)}와 ${domain.id} 두 영역에 있습니다`);
    owner.set(id, domain.id);
  }
}
const unmapped = published.filter((p) => !owner.has(p.id)).map((p) => p.id);
if (unmapped.length > 0) {
  throw new Error(`be-commerce 허브: 영역이 정해지지 않은 공개 글 ${unmapped.join(', ')}. src/data/be-commerce-hub.ts에 추가하세요.`);
}

// 초안·unlisted로 바뀐 글은 매핑에 남아 있어도 목록에서 빠진다.
const domains = hubDomains.map((domain) => ({
  ...domain,
  entries: domain.posts
    .map((id) => publishedById.get(id))
    .filter((p): p is NonNullable<typeof p> => Boolean(p))
    .sort((a, b) => (a.data.seriesOrder ?? 999) - (b.data.seriesOrder ?? 999)),
}));

const totalPosts = domains.reduce((n, d) => n + d.entries.length, 0);
const edgeData = JSON.stringify(hubEdges);
---

<BaseLayout
  title="BE-commerce — IT Oasis"
  description="BE-commerce를 영역별로 나눠 봅니다. 유입부터 결제, 정산, 리스크, AI 운영, 개인화까지 각 영역에서 내린 판단과 트레이드오프 글을 모았습니다."
  wide
>
  <header class="hub-head">
    <h1 class="hub-title">BE-commerce</h1>
    <p class="hub-lead">
      상품 탐색부터 주문, 결제, 정산, 대사까지 다루는 이커머스 백엔드입니다.
      영역을 고르면 그 영역에서 내린 판단과 트레이드오프 글이 아래에 모입니다.
    </p>
    <nav class="hub-links" aria-label="프로젝트 바로가기">
      <a href={`${base}/blog/${OVERVIEW_ID}`}>전체 개요 읽기</a>
      <a href={REPO_URL} target="_blank" rel="noopener noreferrer">GitHub 저장소</a>
    </nav>
  </header>

  <section class="flow" aria-label="BE-commerce 영역 지도">
    <div class="flow-map" data-flow-map data-edges={edgeData}>
      <svg class="flow-lines" aria-hidden="true" data-flow-lines></svg>
      <span class="flow-dot" aria-hidden="true" data-flow-dot></span>

      <p class="flow-note">
        선을 따라 움직이는 점은 주문 한 건이 그 영역에 닿기까지 지나는 길입니다.
      </p>

      {domains.map((d) => (
        <button
          type="button"
          class:list={['node', d.core && 'node--core']}
          style={`--col:${d.col};--row:${d.row}`}
          data-node={d.id}
          aria-pressed="false"
          aria-controls="hub-list"
        >
          <span class="node-name">{d.name}</span>
          <span class="node-tagline">{d.tagline}</span>
          <span class="node-modules">
            {d.modules.map((m) => <code>{m}</code>)}
          </span>
          <span class:list={['node-count', d.entries.length === 0 && 'node-count--empty']}>
            {d.entries.length > 0 ? `글 ${d.entries.length}편` : '글 준비 중'}
          </span>
        </button>
      ))}
    </div>
  </section>

  <section id="hub-list" class="hub-list" aria-live="polite">
    <div class="hub-list-bar">
      <p class="hub-list-status" data-hub-status>
        영역 {domains.length}곳, 공개 글 {totalPosts}편
      </p>
      <button type="button" class="hub-reset" data-hub-reset hidden>모든 영역 보기</button>
    </div>

    {domains.map((d) => (
      <section class="domain" data-domain-section={d.id} aria-labelledby={`domain-${d.id}`}>
        <div class="domain-head">
          <h2 id={`domain-${d.id}`} class="domain-name">
            <a href={`#${d.id}`} data-domain-link={d.id}>{d.name}</a>
          </h2>
          <p class="domain-summary">{d.summary}</p>
          <p class="domain-doc">
            저장소 문서: <a href={d.doc.url} target="_blank" rel="noopener noreferrer">{d.doc.label}</a>
          </p>
        </div>

        {d.entries.length > 0 ? (
          <div class="domain-posts">
            {d.entries.map((post, i) => (
              <PostCard
                title={post.data.title}
                description={post.data.description}
                date={post.data.date}
                slug={post.id}
                tags={post.data.tags}
                category={post.data.category}
                coverImage={post.data.coverImage}
                index={i}
              />
            ))}
          </div>
        ) : (
          <p class="domain-empty">
            이 영역의 글은 아직 없습니다. 설계와 실측 기록은 위 저장소 문서에서 먼저 볼 수 있습니다.
          </p>
        )}
      </section>
    ))}
  </section>
</BaseLayout>

<script>
  type Edge = { from: string; to: string; label: string };

  // 유입에서 각 영역까지 점이 지나는 길. 지도 위의 선을 이어 붙인 것이다.
  const ROUTES: Record<string, string[]> = {
    entry: ['entry'],
    storefront: ['entry', 'storefront'],
    personalization: ['entry', 'storefront', 'personalization'],
    payment: ['entry', 'storefront', 'payment'],
    settlement: ['entry', 'storefront', 'payment', 'settlement'],
    risk: ['entry', 'storefront', 'payment', 'risk'],
    ai: ['entry', 'storefront', 'payment', 'ai'],
  };

  let controller: AbortController | null = null;

  function initHub() {
    const map = document.querySelector<HTMLElement>('[data-flow-map]');
    if (!map) return;

    controller?.abort();
    controller = new AbortController();
    const { signal } = controller;

    const svg = map.querySelector<SVGSVGElement>('[data-flow-lines]')!;
    const dot = map.querySelector<HTMLElement>('[data-flow-dot]')!;
    const nodes = new Map(
      Array.from(map.querySelectorAll<HTMLButtonElement>('[data-node]')).map((el) => [el.dataset.node!, el]),
    );
    const edges: Edge[] = JSON.parse(map.dataset.edges || '[]');
    const sections = Array.from(document.querySelectorAll<HTMLElement>('[data-domain-section]'));
    const status = document.querySelector<HTMLElement>('[data-hub-status]')!;
    const reset = document.querySelector<HTMLButtonElement>('[data-hub-reset]')!;
    const list = document.getElementById('hub-list')!;
    const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)');
    const initialStatus = status.textContent?.trim() ?? '';

    // 선의 꼭짓점 목록. 같은 줄이면 옆으로, 아래 줄이면 아래로 꺾어 내려간다.
    // offset* 값을 쓴다. getBoundingClientRect는 확대된 타일의 크기를 돌려줘 줄 판정이 틀어진다.
    function segment(fromId: string, toId: string): [number, number][] {
      const a = nodes.get(fromId)!, b = nodes.get(toId)!;
      const ax = a.offsetLeft, ay = a.offsetTop, bx = b.offsetLeft, by = b.offsetTop;
      const aCx = ax + a.offsetWidth / 2, bCx = bx + b.offsetWidth / 2;
      if (Math.abs(ay - by) < 4) {
        const y = ay + a.offsetHeight / 2;
        return [[ax + a.offsetWidth, y], [bx, y]];
      }
      const startY = ay + a.offsetHeight;
      if (Math.abs(aCx - bCx) < 4) return [[aCx, startY], [bCx, by]];
      const midY = (startY + by) / 2;
      return [[aCx, startY], [aCx, midY], [bCx, midY], [bCx, by]];
    }

    const toPath = (pts: [number, number][]) =>
      pts.map(([x, y], i) => `${i === 0 ? 'M' : 'L'} ${x.toFixed(1)} ${y.toFixed(1)}`).join(' ');

    function draw() {
      svg.setAttribute('viewBox', `0 0 ${map!.clientWidth} ${map!.clientHeight}`);
      svg.innerHTML = edges
        .map((e) => {
          const pts = segment(e.from, e.to);
          // 라벨은 가장 긴 구간의 가운데에 둔다. 세로 선 라벨은 선 왼쪽에 둬서
          // 같은 타일에서 오른쪽으로 꺾여 나가는 선과 겹치지 않게 한다.
          let best = 0, lx = 0, ly = 0;
          for (let i = 1; i < pts.length; i++) {
            const len = Math.hypot(pts[i][0] - pts[i - 1][0], pts[i][1] - pts[i - 1][1]);
            if (len > best) {
              best = len;
              lx = (pts[i][0] + pts[i - 1][0]) / 2;
              ly = (pts[i][1] + pts[i - 1][1]) / 2;
            }
          }
          const vertical = pts.length === 2 && pts[0][0] === pts[1][0];
          return `<g class="edge" data-edge="${e.from}>${e.to}">
            <path d="${toPath(pts)}" />
            <text x="${vertical ? lx - 8 : lx}" y="${vertical ? ly + 4 : ly - 8}" text-anchor="${vertical ? 'end' : 'middle'}">${e.label}</text>
          </g>`;
        })
        .join('');
      if (active || hovered) light(hovered || active!);
    }

    function routePath(id: string): string | null {
      const route = ROUTES[id];
      if (!route || route.length < 2) return null;
      const pts: [number, number][] = [];
      for (let i = 1; i < route.length; i++) {
        const seg = segment(route[i - 1], route[i]);
        pts.push(...seg);
      }
      return toPath(pts);
    }

    function light(id: string | null) {
      const route = id ? ROUTES[id] ?? [] : [];
      const pairs = new Set(route.slice(1).map((to, i) => `${route[i]}>${to}`));
      svg.querySelectorAll<SVGGElement>('[data-edge]').forEach((g) => {
        g.classList.toggle('is-lit', pairs.has(g.dataset.edge!));
      });
      nodes.forEach((el, key) => el.classList.toggle('is-on-route', route.includes(key) && key !== id));
    }

    function run(id: string) {
      const d = routePath(id);
      if (!d || reduceMotion.matches) {
        dot.classList.remove('is-running');
        return;
      }
      dot.style.offsetPath = `path('${d}')`;
      dot.classList.remove('is-running');
      void dot.offsetWidth; // 애니메이션을 처음부터 다시 시작한다
      dot.classList.add('is-running');
    }

    let active: string | null = null;
    let hovered: string | null = null;

    function select(id: string | null, { scroll = false } = {}) {
      active = id && nodes.has(id) ? id : null;
      nodes.forEach((el, key) => {
        const on = key === active;
        el.classList.toggle('is-active', on);
        el.setAttribute('aria-pressed', String(on));
      });
      sections.forEach((s) => {
        s.hidden = active !== null && s.dataset.domainSection !== active;
      });
      reset.hidden = active === null;
      if (active) {
        const node = nodes.get(active)!;
        const count = node.querySelector('.node-count')?.textContent?.trim() ?? '';
        status.textContent = `${node.querySelector('.node-name')?.textContent ?? ''} 영역, ${count}`;
        history.replaceState(null, '', `#${active}`);
      } else {
        status.textContent = initialStatus;
        history.replaceState(null, '', location.pathname + location.search);
      }
      light(active);
      if (scroll) {
        const top = list.getBoundingClientRect().top;
        if (top > window.innerHeight * 0.6 || top < 0) {
          list.scrollIntoView({ behavior: reduceMotion.matches ? 'auto' : 'smooth', block: 'start' });
        }
      }
    }

    nodes.forEach((el, id) => {
      el.addEventListener('mouseenter', () => { hovered = id; light(id); run(id); }, { signal });
      el.addEventListener('mouseleave', () => { hovered = null; light(active); }, { signal });
      el.addEventListener('focus', () => { light(id); run(id); }, { signal });
      el.addEventListener('blur', () => light(active), { signal });
      el.addEventListener('click', () => {
        select(active === id ? null : id, { scroll: true });
        run(id);
      }, { signal });
    });

    document.querySelectorAll<HTMLAnchorElement>('[data-domain-link]').forEach((a) => {
      a.addEventListener('click', (ev) => {
        ev.preventDefault();
        select(a.dataset.domainLink!, { scroll: false });
      }, { signal });
    });

    reset.addEventListener('click', () => select(null), { signal });

    const ro = new ResizeObserver(() => draw());
    ro.observe(map);
    signal.addEventListener('abort', () => ro.disconnect());

    draw();
    select(location.hash.slice(1) || null);
  }

  initHub();
  document.addEventListener('astro:page-load', initHub);
</script>

<style>
  .hub-head {
    max-width: 44rem;
    margin: 0.5rem 0 2.25rem;
  }

  .hub-title {
    font-size: clamp(2.5rem, 6vw, 4rem);
    font-weight: 800;
    letter-spacing: -0.035em;
    line-height: 1;
    margin: 0 0 1rem;
  }

  .hub-lead {
    font-size: 1.0625rem;
    line-height: 1.75;
    color: #4b5563;
    margin: 0 0 1.25rem;
  }

  .hub-links {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem 1.25rem;
    font-size: 0.9375rem;
    font-weight: 600;
  }

  .hub-links a {
    color: var(--color-primary);
    text-decoration: underline;
    text-decoration-color: rgba(74, 141, 184, 0.35);
    text-underline-offset: 4px;
  }

  .hub-links a:hover {
    text-decoration-color: currentColor;
  }

  /* ── 흐름 지도 ─────────────────────────────── */

  .flow {
    --ink: #1f2a37;
    --muted: #6b7280;
    --line: #c7d3de;
    --lit: #4a8db8;
    --panel: #f5f8fb;
    --tile: #ffffff;
    --tile-border: #dbe4ec;
    margin-bottom: 3.5rem;
  }

  :global(.dark) .flow {
    --ink: #e5e9f0;
    --muted: #9aa5b4;
    --line: #3a4658;
    --lit: #8db8d0;
    --panel: #171b26;
    --tile: #1e2331;
    --tile-border: #2e3749;
  }

  .flow-map {
    position: relative;
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    grid-template-rows: auto auto;
    column-gap: clamp(4.5rem, 7vw, 6rem);
    row-gap: 4.5rem;
    padding: clamp(1.5rem, 3vw, 2.5rem);
    border-radius: 1.25rem;
    background-color: var(--panel);
    background-image: radial-gradient(circle at 1px 1px, rgba(74, 141, 184, 0.14) 1px, transparent 0);
    background-size: 22px 22px;
  }

  .flow-lines {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    pointer-events: none;
    overflow: visible;
  }

  .flow-lines :global(.edge path) {
    fill: none;
    stroke: var(--line);
    stroke-width: 1.5;
    stroke-dasharray: 4 5;
    transition: stroke 0.25s ease;
  }

  .flow-lines :global(.edge text) {
    font-size: 11px;
    font-weight: 600;
    fill: var(--muted);
    paint-order: stroke;
    stroke: var(--panel);
    stroke-width: 5px;
    stroke-linejoin: round;
    transition: fill 0.25s ease;
  }

  .flow-lines :global(.edge.is-lit path) {
    stroke: var(--lit);
    stroke-width: 2.25;
    stroke-dasharray: none;
  }

  .flow-lines :global(.edge.is-lit text) {
    fill: var(--lit);
  }

  .flow-dot {
    position: absolute;
    top: 0;
    left: 0;
    width: 12px;
    height: 12px;
    border-radius: 50%;
    background: var(--lit);
    box-shadow: 0 0 0 4px rgba(74, 141, 184, 0.22);
    offset-rotate: 0deg;
    offset-anchor: 50% 50%;
    opacity: 0;
    pointer-events: none;
    /* 타일(z-index 2) 아래로 지나가 타일에 들어갔다 나오는 것처럼 보인다 */
    z-index: 1;
  }

  .flow-dot.is-running {
    animation: travel 1.1s cubic-bezier(0.45, 0, 0.2, 1) forwards;
  }

  @keyframes travel {
    0% { offset-distance: 0%; opacity: 0; }
    8% { opacity: 1; }
    88% { opacity: 1; }
    100% { offset-distance: 100%; opacity: 0; }
  }

  .flow-note {
    grid-column: 1;
    grid-row: 2;
    align-self: center;
    margin: 0;
    font-size: 0.8125rem;
    line-height: 1.6;
    color: var(--muted);
    max-width: 14rem;
  }

  .node {
    position: relative;
    z-index: 2;
    grid-column: var(--col);
    grid-row: var(--row);
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 0.35rem;
    padding: 1rem 1.1rem;
    text-align: left;
    color: var(--ink);
    background: var(--tile);
    border: 1px solid var(--tile-border);
    border-radius: 0.875rem;
    cursor: pointer;
    transform-origin: 50% 60%;
    transition:
      transform 0.28s cubic-bezier(0.2, 0.8, 0.2, 1),
      box-shadow 0.28s ease,
      border-color 0.2s ease;
  }

  .node--core {
    border-width: 2px;
    border-color: var(--lit);
  }

  .node--core .node-name {
    font-size: 1.5rem;
  }

  .node:hover,
  .node:focus-visible {
    transform: scale(1.07);
    box-shadow: 0 18px 40px -18px rgba(31, 60, 90, 0.45);
    border-color: var(--lit);
    z-index: 4;
  }

  .node:focus-visible {
    outline: 3px solid var(--lit);
    outline-offset: 3px;
  }

  .node.is-on-route {
    border-color: var(--lit);
  }

  .node.is-active {
    background: var(--lit);
    border-color: var(--lit);
    color: #fff;
  }

  .node-name {
    font-size: 1.125rem;
    font-weight: 800;
    letter-spacing: -0.02em;
  }

  .node-tagline {
    font-size: 0.8125rem;
    color: var(--muted);
  }

  .node-modules {
    display: flex;
    flex-wrap: wrap;
    gap: 0.25rem;
    margin-top: 0.35rem;
    /* 자리는 늘 잡아 둔다. 펼치면 같은 줄 타일 높이가 바뀌어 지도가 출렁인다. */
    opacity: 0.5;
    transition: opacity 0.2s ease;
  }

  .node-modules code {
    font-family: var(--font-mono);
    font-size: 0.6875rem;
    padding: 0.1rem 0.35rem;
    border-radius: 0.3rem;
    background: rgba(74, 141, 184, 0.1);
  }

  .node:hover .node-modules,
  .node:focus-visible .node-modules,
  .node.is-active .node-modules {
    opacity: 1;
  }

  .node-count {
    margin-top: auto;
    font-size: 0.75rem;
    font-weight: 700;
    color: var(--lit);
  }

  .node-count--empty {
    color: var(--muted);
    font-weight: 600;
  }

  .node.is-active .node-tagline,
  .node.is-active .node-count {
    color: rgba(255, 255, 255, 0.85);
  }

  .node.is-active .node-modules code {
    background: rgba(255, 255, 255, 0.18);
  }

  /* 좁은 화면에서는 선을 접고 타일만 흐름 순서대로 쌓는다. */
  @media (max-width: 860px) {
    .flow-map {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 0.75rem;
    }

    .flow-lines,
    .flow-dot {
      display: none;
    }

    .node {
      grid-column: auto;
      grid-row: auto;
      min-height: 0;
    }

    .node--core {
      grid-column: 1 / -1;
      order: -1;
    }

    .flow-note {
      display: none;
    }

    .node:hover,
    .node:focus-visible {
      transform: scale(1.03);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .node,
    .node-modules,
    .flow-lines :global(.edge path),
    .flow-lines :global(.edge text) {
      transition: none;
    }

    .node:hover,
    .node:focus-visible {
      transform: none;
    }

    .flow-dot {
      display: none;
    }
  }

  /* ── 영역별 글 ─────────────────────────────── */

  .hub-list {
    scroll-margin-top: 5rem;
  }

  .hub-list-bar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    margin-bottom: 1.5rem;
    padding-bottom: 0.75rem;
    border-bottom: 1px solid rgba(15, 40, 80, 0.1);
  }

  :global(.dark) .hub-list-bar {
    border-bottom-color: rgba(255, 255, 255, 0.1);
  }

  .hub-list-status {
    margin: 0;
    font-size: 0.875rem;
    font-weight: 600;
    color: #6b7280;
  }

  .hub-reset {
    border: 1px solid rgba(74, 141, 184, 0.3);
    border-radius: 999px;
