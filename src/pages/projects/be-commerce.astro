---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import PostCard from '../../components/PostCard.astro';
import FlowMap from '../../components/FlowMap.astro';
import { getPublishedPosts } from '../../lib/posts';
import { base } from '../../lib/config';
import { hubDomains, hubEdges, OVERVIEW_ID } from '../../data/be-commerce-hub';

const REPO_URL = 'https://github.com/dj258255/BE-commerce';
const PREFIX = 'project/be-commerce/';

// 영역 매핑이 글과 어긋나면 빌드를 멈춘다. 새 글이 허브에서 조용히 빠지는 것을 막는다.
const allIds = new Set((await getCollection('blog')).map((p) => p.id));
const published = (await getPublishedPosts()).filter((p) => p.id.startsWith(PREFIX) && p.id !== OVERVIEW_ID);
const publishedById = new Map(published.map((p) => [p.id, p]));

const owner = new Map<string, string>();
for (const domain of hubDomains) {
  for (const id of domain.posts) {
    if (!allIds.has(id)) throw new Error(`be-commerce 허브: 없는 글 id "${id}" (영역 ${domain.id})`);
    if (owner.has(id)) throw new Error(`be-commerce 허브: "${id}"가 ${owner.get(id)}와 ${domain.id} 두 영역에 있습니다`);
    owner.set(id, domain.id);
  }
}
const unmapped = published.filter((p) => !owner.has(p.id)).map((p) => p.id);
if (unmapped.length > 0) {
  throw new Error(`be-commerce 허브: 영역이 정해지지 않은 공개 글 ${unmapped.join(', ')}. src/data/be-commerce-hub.ts에 추가하세요.`);
}

// 초안·unlisted로 바뀐 글은 매핑에 남아 있어도 목록에서 빠진다.
const domains = hubDomains.map((domain) => ({
  ...domain,
  entries: domain.posts
    .map((id) => publishedById.get(id))
    .filter((p): p is NonNullable<typeof p> => Boolean(p))
    .sort((a, b) => (a.data.seriesOrder ?? 999) - (b.data.seriesOrder ?? 999)),
}));

const totalPosts = domains.reduce((n, d) => n + d.entries.length, 0);
const tiles = domains.map((d) => ({ ...d, count: d.entries.length }));
---

<BaseLayout
  title="BE-commerce — IT Oasis"
  description="BE-commerce를 영역별로 나눠 봅니다. 유입부터 결제, 정산, 리스크, AI 운영, 개인화까지 각 영역에서 내린 판단과 트레이드오프 글을 모았습니다."
  wide
>
  <header class="hub-head">
    <h1 class="hub-title">BE-commerce</h1>
    <p class="hub-lead">
      상품 탐색부터 주문, 결제, 정산, 대사까지 다루는 이커머스 백엔드입니다.
      영역을 고르면 그 영역에서 내린 판단과 트레이드오프 글이 아래에 모입니다.
    </p>
    <nav class="hub-links" aria-label="프로젝트 바로가기">
      <a href={`${base}/blog/${OVERVIEW_ID}`}>전체 개요 읽기</a>
      <a href={REPO_URL} target="_blank" rel="noopener noreferrer">GitHub 저장소</a>
    </nav>
  </header>

  <section class="flow">
    <FlowMap tiles={tiles} edges={hubEdges} label="BE-commerce 영역 지도" controls="hub-list">
      선을 따라 움직이는 점은 주문 한 건이 그 영역에 닿기까지 지나는 길입니다.
    </FlowMap>
  </section>

  <section id="hub-list" class="hub-list" aria-live="polite">
    <div class="hub-list-bar">
      <p class="hub-list-status" data-hub-status>
        영역 {domains.length}곳, 공개 글 {totalPosts}편
      </p>
      <button type="button" class="hub-reset" data-hub-reset hidden>모든 영역 보기</button>
    </div>

    {domains.map((d) => (
      <section class="domain" data-domain-section={d.id} aria-labelledby={`domain-${d.id}`}>
        <div class="domain-head">
          <h2 id={`domain-${d.id}`} class="domain-name">
            <a href={`#${d.id}`} data-domain-link={d.id}>{d.name}</a>
          </h2>
          <p class="domain-summary">{d.summary}</p>
          <p class="domain-doc">
            저장소 문서: <a href={d.doc.url} target="_blank" rel="noopener noreferrer">{d.doc.label}</a>
          </p>
        </div>

        {d.entries.length > 0 ? (
          <div class="domain-posts">
            {d.entries.map((post, i) => (
              <PostCard
                title={post.data.title}
                description={post.data.description}
                date={post.data.date}
                slug={post.id}
                tags={post.data.tags}
                category={post.data.category}
                coverImage={post.data.coverImage}
                index={i}
              />
            ))}
          </div>
        ) : (
          <p class="domain-empty">
            이 영역의 글은 아직 없습니다. 설계와 실측 기록은 위 저장소 문서에서 먼저 볼 수 있습니다.
          </p>
        )}
      </section>
    ))}
  </section>
</BaseLayout>

<script>
  import { initFlowMap } from '../../lib/flow-map';

  let controller: AbortController | null = null;

  function initHub() {
    const map = document.querySelector<HTMLElement>('.flow [data-flow-map]');
    if (!map) return;
    controller?.abort();
    controller = new AbortController();
    const { signal } = controller;

    const sections = Array.from(document.querySelectorAll<HTMLElement>('[data-domain-section]'));
    const status = document.querySelector<HTMLElement>('[data-hub-status]')!;
    const reset = document.querySelector<HTMLButtonElement>('[data-hub-reset]')!;
    const list = document.getElementById('hub-list')!;
    const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)');
    const initialStatus = status.textContent?.trim() ?? '';

    // 아래 목록을 고른 영역에 맞춘다. 지도 타일의 표시는 flow-map이 맡는다.
    function show(id: string | null, { scroll = false } = {}) {
      const tile = id && /^[a-z-]+$/.test(id) ? map!.querySelector<HTMLElement>(`[data-node="${id}"]`) : null;
      const active = tile ? id : null;
      sections.forEach((s) => {
        s.hidden = active !== null && s.dataset.domainSection !== active;
      });
      reset.hidden = active === null;
      if (tile) {
        const name = tile.querySelector('.node-name')?.textContent ?? '';
        const count = tile.querySelector('.node-count')?.textContent?.trim() ?? '';
        status.textContent = `${name} 영역, ${count}`;
        history.replaceState(null, '', `#${active}`);
      } else {
        status.textContent = initialStatus;
        history.replaceState(null, '', location.pathname + location.search);
      }
      if (scroll) {
        const top = list.getBoundingClientRect().top;
        if (top > window.innerHeight * 0.6 || top < 0) {
          list.scrollIntoView({ behavior: reduceMotion.matches ? 'auto' : 'smooth', block: 'start' });
        }
      }
    }

    const flow = initFlowMap(map, {
      signal,
      allowDeselect: true,
      onSelect: (id) => show(id, { scroll: true }),
    });

    function pick(id: string | null) {
      flow.select(id);
      show(flow.selected());
    }

    document.querySelectorAll<HTMLAnchorElement>('[data-domain-link]').forEach((a) => {
      a.addEventListener('click', (ev) => {
        ev.preventDefault();
        pick(a.dataset.domainLink!);
      }, { signal });
    });

    reset.addEventListener('click', () => pick(null), { signal });

    pick(decodeURIComponent(location.hash.slice(1)) || null);
  }

  initHub();
  document.addEventListener('astro:page-load', initHub);
</script>

<style>
  .hub-head {
    max-width: 44rem;
    margin: 0.5rem 0 2.25rem;
  }

  .hub-title {
    font-size: clamp(2.5rem, 6vw, 4rem);
    font-weight: 800;
    letter-spacing: -0.035em;
    line-height: 1;
    margin: 0 0 1rem;
  }

  .hub-lead {
    font-size: 1.0625rem;
    line-height: 1.75;
    color: #4b5563;
    margin: 0 0 1.25rem;
  }

  .hub-links {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem 1.25rem;
    font-size: 0.9375rem;
    font-weight: 600;
  }

  .hub-links a {
    color: var(--color-primary);
    text-decoration: underline;
    text-decoration-color: rgba(74, 141, 184, 0.35);
    text-underline-offset: 4px;
  }

  .hub-links a:hover {
    text-decoration-color: currentColor;
  }

  .flow {
    margin-bottom: 3.5rem;
  }

  /* ── 영역별 글 ─────────────────────────────── */

  .hub-list {
    scroll-margin-top: 5rem;
  }

  .hub-list-bar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    margin-bottom: 1.5rem;
    padding-bottom: 0.75rem;
    border-bottom: 1px solid rgba(15, 40, 80, 0.1);
  }

  :global(.dark) .hub-list-bar {
    border-bottom-color: rgba(255, 255, 255, 0.1);
  }

  .hub-list-status {
    margin: 0;
    font-size: 0.875rem;
    font-weight: 600;
    color: #6b7280;
  }

  .hub-reset {
    border: 1px solid rgba(74, 141, 184, 0.3);
    border-radius: 999px;
    background: transparent;
    color: var(--color-primary);
    font-size: 0.8125rem;
    font-weight: 700;
    padding: 0.45rem 0.95rem;
    cursor: pointer;
  }

  .hub-reset:hover {
    background: rgba(74, 141, 184, 0.1);
  }

  .domain {
    margin-bottom: 3.5rem;
  }

  .domain[hidden] {
    display: none;
  }

  .domain-head {
    max-width: 44rem;
    margin-bottom: 1.25rem;
  }

  .domain-name {
    font-size: 1.625rem;
    font-weight: 800;
    letter-spacing: -0.025em;
    margin: 0 0 0.5rem;
  }

  .domain-name a {
    color: inherit;
    text-decoration: none;
  }

  .domain-name a:hover {
    color: var(--color-primary);
  }

  .domain-summary {
    margin: 0 0 0.5rem;
    font-size: 0.9875rem;
    line-height: 1.75;
    color: #4b5563;
  }

  .domain-doc {
    margin: 0;
    font-size: 0.875rem;
    color: #6b7280;
  }

  .domain-doc a {
    color: var(--color-primary);
    font-weight: 600;
  }

  :global(.dark) .hub-lead,
  :global(.dark) .domain-summary {
    color: #c3cad5;
  }

  :global(.dark) .hub-list-status,
  :global(.dark) .domain-doc {
    color: #9aa5b4;
  }

  .domain-posts {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(290px, 1fr));
    gap: 1.25rem;
  }

  .domain-empty {
    margin: 0;
    padding: 1.25rem 1.5rem;
    border: 1px dashed rgba(74, 141, 184, 0.35);
    border-radius: 0.875rem;
    font-size: 0.9375rem;
    color: #6b7280;
  }

  :global(.dark) .domain-empty {
    color: #9aa5b4;
  }
</style>
