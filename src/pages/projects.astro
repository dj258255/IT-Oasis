---
import BaseLayout from '../layouts/BaseLayout.astro';
import { projects, projectTypeLabels } from '../data/projects';
import { base } from '../lib/config';

const linkList = (field: unknown, fallbackLabel: string) =>
  Array.isArray(field)
    ? (field as { label: string; url: string }[]).map((l) => ({ label: l.label, url: l.url }))
    : field
      ? [{ label: fallbackLabel, url: String(field) }]
      : [];
---

<BaseLayout title="프로젝트 — IT Oasis">
  <h1 class="text-[28px] sm:text-[32px] font-bold leading-[1.3] tracking-[-0.02em]">프로젝트</h1>

  <div class="text-links mt-5" role="group" aria-label="프로젝트 분류">
    <button type="button" class="is-active" data-project-filter="featured" aria-pressed="true">팀·사이드 프로젝트</button>
    <button type="button" data-project-filter="team" aria-pressed="false">팀 프로젝트</button>
    <button type="button" data-project-filter="side" aria-pressed="false">사이드 프로젝트</button>
    <button type="button" data-project-filter="toy" aria-pressed="false">토이 프로젝트</button>
    <button type="button" data-project-filter="all" aria-pressed="false">전체</button>
  </div>

  <ul class="mt-6 m-0 p-0 list-none">
    {projects.map((project) => {
      const links = [
        ...(project.story ? [{ label: '스토리', url: `${base}${project.hub ?? project.story}` }] : []),
        ...linkList(project.website, '웹사이트'),
        ...linkList(project.github, '깃허브'),
      ];
      return (
        <li class="project-item" data-project-type={project.projectType} hidden={project.projectType === 'toy'}>
          <h2 class="project-title">
            {project.story ? <a href={`${base}${project.hub ?? project.story}`}>{project.title}</a> : project.title}
          </h2>
          <p class="project-meta">{projectTypeLabels[project.projectType]} &middot; {project.date}</p>
          <p class="project-desc">{project.description}</p>
          {project.tags.length > 0 && <p class="project-tags">{project.tags.join(' · ')}</p>}
          {links.length > 0 && (
            <p class="project-links">
              {links.map((l) => <a href={l.url} target={l.url.startsWith('http') ? '_blank' : undefined} rel={l.url.startsWith('http') ? 'noopener noreferrer' : undefined}>{l.label}</a>)}
            </p>
          )}
        </li>
      );
    })}
  </ul>
</BaseLayout>

<script>
  function initProjectFilter() {
    const filterButtons = Array.from(document.querySelectorAll<HTMLButtonElement>('[data-project-filter]'));
    const items = Array.from(document.querySelectorAll<HTMLElement>('[data-project-type]'));
    if (filterButtons.length === 0) return;

    function apply(filter: string) {
      items.forEach((item) => {
        const type = item.dataset.projectType;
        item.hidden = filter === 'all' ? false : filter === 'featured' ? type === 'toy' : type !== filter;
      });
      filterButtons.forEach((button) => {
        const active = button.dataset.projectFilter === filter;
        button.classList.toggle('is-active', active);
        button.setAttribute('aria-pressed', String(active));
      });
    }

    const ac = new AbortController();
    (window as any).__projectFilterAC?.abort();
    (window as any).__projectFilterAC = ac;
    filterButtons.forEach((button) => {
      button.addEventListener('click', () => apply(button.dataset.projectFilter || 'featured'), { signal: ac.signal });
    });
  }

  initProjectFilter();
  document.addEventListener('astro:page-load', initProjectFilter);
</script>

<style>
  .project-item {
    padding: 1.4rem 0;
    border-bottom: 1px solid #d1d9e0;
  }
  :global(.dark) .project-item { border-bottom-color: #3d444d; }
  .project-item[hidden] { display: none; }
  .project-title {
    margin: 0;
    font-size: 19px;
    font-weight: 700;
    line-height: 1.4;
    color: #1f2328;
  }
  :global(.dark) .project-title { color: #f0f6fc; }
  .project-title a { color: inherit; text-decoration: none; }
  .project-title a:hover { color: #1a6aa0; text-decoration: underline; text-underline-offset: 3px; }
  :global(.dark) .project-title a:hover { color: #8db8d0; }
  .project-meta, .project-tags {
    margin: 0.15rem 0 0;
    font-size: 13.5px;
    color: #59636e;
  }
  :global(.dark) .project-meta, :global(.dark) .project-tags { color: #8b949e; }
  .project-desc {
    margin: 0.6rem 0 0;
    font-size: 16px;
    line-height: 1.7;
  }
  .project-tags { margin-top: 0.5rem; }
  .project-links {
    display: flex;
    flex-wrap: wrap;
    gap: 0.25rem 1rem;
    margin: 0.6rem 0 0;
    font-size: 14.5px;
  }
  .project-links a {
    color: #1a6aa0;
    text-decoration: underline;
    text-underline-offset: 3px;
  }
  :global(.dark) .project-links a { color: #8db8d0; }
</style>
