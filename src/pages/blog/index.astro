---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PostCard from '../../components/PostCard.astro';
import { getPublishedPosts } from '../../lib/posts';
import { getCategoryDisplayKo } from '../../lib/config';

// 스토리 목록은 프로젝트 소개·회고까지 포함한 공개 글 전부를 보여준다.
// (프로젝트 글을 잠시 숨겼던 것은 품질 관리가 안 되던 시기의 임시 조치였다.)
const posts = await getPublishedPosts();
const catDisplayKo = getCategoryDisplayKo();

// Collect all categories (full path) from posts
const allCats = new Map<string, { ko: string; parent: string }>();
for (const post of posts) {
  const cat = post.data.category;
  if (!cat) continue;
  if (!allCats.has(cat)) {
    const parts = cat.split('/');
    const parentKey = parts[0];
    const parentKo = catDisplayKo.get(parentKey) || parentKey;
    let ko: string;
    if (parts.length > 1) {
      const childKo = catDisplayKo.get(parts[1]) || parts[1];
      ko = `${parentKo}(${childKo})`;
    } else {
      ko = parentKo;
    }
    allCats.set(cat, { ko, parent: parentKey });
  }
}

// Fixed order: 일상 → 활동 → 이론 → 웹 개발 → 팀 프로젝트 → 개인 프로젝트 → 학습 프로젝트
const parentDisplayOrder = ['daily', 'activity', 'theory', 'web', 'team', 'personal', 'study'];
const sortedCats = [...allCats.entries()].sort((a, b) => {
  const idxA = parentDisplayOrder.indexOf(a[1].parent);
  const idxB = parentDisplayOrder.indexOf(b[1].parent);
  const oA = idxA === -1 ? 999 : idxA;
  const oB = idxB === -1 ? 999 : idxB;
  if (oA !== oB) return oA - oB;
  // Same parent: non-sub first, then subs alphabetically
  const aIsSub = a[0].includes('/');
  const bIsSub = b[0].includes('/');
  if (!aIsSub && bIsSub) return -1;
  if (aIsSub && !bIsSub) return 1;
  return a[1].ko.localeCompare(b[1].ko);
});

// Group into parents (+ optional children) for the toggle UI.
// Parents with children render as an expandable group; parents without
// children render as a plain pill. sortedCats is already ordered, so
// insertion order + children push order are preserved.
type CatGroup = {
  parentKey: string;
  parentKo: string;
  selfKey: string | null; // a parent-only post (category without "/"), if any
  children: { key: string; ko: string }[];
};
const groupsMap = new Map<string, CatGroup>();
for (const [key, val] of sortedCats) {
  const p = val.parent;
  if (!groupsMap.has(p)) {
    groupsMap.set(p, {
      parentKey: p,
      parentKo: catDisplayKo.get(p) || p,
      selfKey: null,
      children: [],
    });
  }
  const g = groupsMap.get(p)!;
  if (key.includes('/')) {
    const childPart = key.split('/')[1];
    g.children.push({
      key,
      ko: catDisplayKo.get(childPart) || childPart,
    });
  } else {
    g.selfKey = key;
  }
}
const groups = [...groupsMap.values()].sort((a, b) => {
  const ia = parentDisplayOrder.indexOf(a.parentKey);
  const ib = parentDisplayOrder.indexOf(b.parentKey);
  return (ia === -1 ? 999 : ia) - (ib === -1 ? 999 : ib);
});
---

<BaseLayout title="스토리 — IT Oasis">
  <div class="fade-in-up mb-8 sm:mb-10">
    {/* Category heading + filter tabs */}
    <div class="px-1 text-center mb-5">
      <h2 class="text-4xl sm:text-5xl font-bold tracking-tight">
        <span class="gradient-text">카테고리</span>
      </h2>
    </div>
    {/* Top row: parent / single pills (always one tidy row) */}
    <div class="cat-filter-area flex flex-wrap items-center gap-2 px-1 justify-center mb-3" id="category-filters">
      <button
        class="cat-filter-btn active"
        data-category="all"
      >
        전체
      </button>
      {groups.map((g) => (
        g.children.length === 0 ? (
          <button
            class="cat-filter-btn"
            data-category={g.selfKey || g.parentKey}
          >
            {g.parentKo}
          </button>
        ) : (
          <button
            class="cat-filter-btn cat-parent-btn"
            data-category={g.parentKey}
            data-parent={g.parentKey}
            aria-expanded="false"
          >
            {g.parentKo}
            <span class="cat-caret" aria-hidden="true">&#8250;</span>
          </button>
        )
      ))}
    </div>

    {/* Sub row: children of the expanded parent appear on the next line */}
    <div class="cat-subrow mb-10" id="category-subrow">
      {groups.filter((g) => g.children.length > 0).map((g) => (
        <div class="cat-subpanel" data-group={g.parentKey}>
          {g.children.map((c, i) => (
            <button
              class="cat-filter-btn cat-child-btn"
              data-category={c.key}
              style={`--i:${i}`}
            >
              {c.ko}
            </button>
          ))}
        </div>
      ))}
    </div>

    <div class="px-1 text-center">
      <h1 class="text-4xl sm:text-5xl font-bold tracking-tight">
        <span class="gradient-text">스토리</span>
      </h1>
    </div>
  </div>

  <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-4 sm:gap-5 stagger" id="posts-grid">
    {posts.map((post, i) => (
      <div class="post-card-wrapper" data-post-category={post.data.category || ''} data-post-parent={post.data.category?.split('/')[0] || ''}>
        <PostCard
          title={post.data.title}
          description={post.data.description}
          date={post.data.date}
          slug={post.id}
          tags={post.data.tags}
          category={post.data.category}
          coverImage={post.data.coverImage}
          index={i}
        />
      </div>
    ))}
  </div>

  {/* 무한 스크롤: 이 표식이 화면 가까이 오면 다음 묶음을 보여 준다 */}
  <div id="posts-sentinel" aria-hidden="true"></div>
  <p id="posts-end" class="posts-end" aria-live="polite" hidden></p>

  <style>
    /* Category filter area - fixed height to prevent layout shift */
    .cat-filter-area {
      min-height: 44px;
      align-content: flex-start;
    }

    /* Category filter buttons */
    .cat-filter-btn {
      padding: 8px 18px;
      border-radius: 100px;
      font-size: 14px;
      font-weight: 500;
      border: 1.5px solid rgba(0, 0, 0, 0.12);
      background: transparent;
      color: #59636e;
      cursor: pointer;
      transition: all 0.25s ease;
      white-space: nowrap;
    }
    :global(.dark) .cat-filter-btn {
      border-color: rgba(255, 255, 255, 0.15);
      background: transparent;
      color: #9198a1;
    }
    .cat-filter-btn:hover {
      border-color: rgba(0, 0, 0, 0.25);
      color: #1f2328;
      background: rgba(0, 0, 0, 0.03);
    }
    :global(.dark) .cat-filter-btn:hover {
      border-color: rgba(255, 255, 255, 0.3);
      color: #e6edf3;
      background: rgba(255, 255, 255, 0.05);
    }
    .cat-filter-btn.active {
      background: #1f2328;
      border-color: #1f2328;
      color: #fff;
      font-weight: 500;
    }
    :global(.dark) .cat-filter-btn.active {
      background: #e6edf3;
      border-color: #e6edf3;
      color: #0d1117;
    }
    /* prevent layout shift on active toggle */
    .cat-filter-btn {
      box-sizing: border-box;
    }

    /* ── Toggle parents (이론 / 프로젝트) ── */
    .cat-parent-btn {
      display: inline-flex;
      align-items: center;
      gap: 6px;
    }
    .cat-caret {
      display: inline-block;
      font-size: 16px;
      line-height: 1;
      transition: transform 0.3s ease;
    }
    .cat-parent-btn[aria-expanded='true'] .cat-caret {
      transform: rotate(90deg);
    }
    /* subtle highlight on the parent when one of its children is active */
    .cat-parent-btn.has-active {
      border-color: rgba(0, 0, 0, 0.4);
      color: #222;
    }
    :global(.dark) .cat-parent-btn.has-active {
      border-color: rgba(255, 255, 255, 0.45);
      color: #eee;
    }

    /* ── Sub row: children appear on the next line when the parent is open ── */
    .cat-subrow {
      display: flex;
      flex-direction: column;
      align-items: center;
    }
    .cat-subpanel {
      display: none; /* only the open panel participates in layout */
      flex-wrap: wrap;
      justify-content: center;
      align-items: center;
      gap: 8px;
      max-width: 760px;
      max-height: 0;
      opacity: 0;
      overflow: hidden;
      transition: max-height 0.4s ease, opacity 0.3s ease, padding 0.3s ease;
    }
    .cat-subpanel.open {
      display: flex;
      max-height: 400px;
      opacity: 1;
      padding: 6px 0 2px;
    }
    /* staggered drop-in for that "쫙" feel */
    .cat-child-btn {
      transform: translateY(-6px);
      opacity: 0;
      transition: transform 0.3s ease, opacity 0.3s ease, background 0.25s ease,
        border-color 0.25s ease, color 0.25s ease;
    }
    .cat-subpanel.open .cat-child-btn {
      transform: translateY(0);
      opacity: 1;
      transition-delay: calc(var(--i, 0) * 0.035s);
    }
    @media (prefers-reduced-motion: reduce) {
      .cat-subpanel,
      .cat-child-btn,
      .cat-caret {
        transition: none;
      }
      .cat-child-btn {
        transform: none;
      }
    }

    /* 목록 끝 안내 */
    .posts-end {
      margin: 3rem 0 0;
      text-align: center;
      font-size: 14px;
      color: #59636e;
    }
    :global(.dark) .posts-end {
      color: #9198a1;
    }
    #posts-sentinel {
      height: 1px;
    }

    /* Smooth hide/show for cards */
    .post-card-wrapper {
      transition: opacity 0.3s ease, transform 0.3s ease;
    }
    .post-card-wrapper.hidden-card {
      display: none;
    }
  </style>

  <script>
    const BATCH = 12; // 1·2·3열 어느 쪽에서도 줄이 꽉 찬 채로 붙는다
    const STATE_KEY = 'blog-list-state';

    type ListState = { filterIdx: number; shown: number; y: number };

    let controller: AbortController | null = null;
    let observer: IntersectionObserver | null = null;

    function readState(): ListState | null {
      try {
        const raw = sessionStorage.getItem(STATE_KEY);
        return raw ? (JSON.parse(raw) as ListState) : null;
      } catch {
        return null;
      }
    }

    function writeState(state: ListState | null) {
      try {
        if (state) sessionStorage.setItem(STATE_KEY, JSON.stringify(state));
        else sessionStorage.removeItem(STATE_KEY);
      } catch {
        /* 저장소를 못 쓰면 복원만 빠진다 */
      }
    }

    function isBackForward() {
      const nav = performance.getEntriesByType('navigation')[0] as PerformanceNavigationTiming | undefined;
      return nav?.type === 'back_forward';
    }

    function initBlogFilter() {
      const grid = document.getElementById('posts-grid');
      const sentinel = document.getElementById('posts-sentinel');
      const endNote = document.getElementById('posts-end');
      if (!grid || !sentinel || !endNote) return;

      controller?.abort();
      observer?.disconnect();
      controller = new AbortController();
      const { signal } = controller;

      const filterBtns = Array.from(document.querySelectorAll<HTMLButtonElement>('.cat-filter-btn'));
      const allCards = Array.from(grid.querySelectorAll<HTMLElement>('.post-card-wrapper'));
      const subpanels = Array.from(document.querySelectorAll<HTMLElement>('.cat-subpanel'));
      const parentBtns = Array.from(document.querySelectorAll<HTMLButtonElement>('.cat-parent-btn'));

      let activeCategory = 'all';
      let activeIdx = Math.max(0, filterBtns.findIndex((b) => b.classList.contains('active')));
      let shown = BATCH;

      function getFilteredCards() {
        if (activeCategory === 'all') return allCards;
        return allCards.filter((c) => {
          const full = c.dataset.postCategory || '';
          // 하위 카테고리는 정확히 같을 때, 상위만 있는 카테고리는 상위가 같을 때
          return full === activeCategory || c.dataset.postParent === activeCategory;
        });
      }

      function render() {
        const filtered = getFilteredCards();
        allCards.forEach((c) => c.classList.add('hidden-card'));
        filtered.slice(0, shown).forEach((c) => c.classList.remove('hidden-card'));

        const done = shown >= filtered.length;
        sentinel!.hidden = done;
        endNote!.hidden = !done || filtered.length === 0;
        endNote!.textContent = done ? `모든 글을 봤습니다 (${filtered.length}편)` : '';
        return done;
      }

      function loadMore() {
        shown += BATCH;
        const done = render();
        // 화면이 커서 표식이 여전히 보이면 관찰을 다시 걸어 한 번 더 받는다
        if (!done && observer) {
          observer.unobserve(sentinel!);
          observer.observe(sentinel!);
        }
      }

      // 아코디언: key 패널만 열고 나머지는 닫는다 (null이면 모두 닫음)
      function openOnly(key: string | null) {
        subpanels.forEach((p) => p.classList.toggle('open', p.dataset.group === key));
        parentBtns.forEach((b) => b.setAttribute('aria-expanded', String(b.dataset.parent === key)));
      }

      function selectFilter(btn: HTMLButtonElement, { toggleParent }: { toggleParent: boolean }) {
        const isParent = !!btn.dataset.parent;
        const ownerKey = btn.closest<HTMLElement>('.cat-subpanel')?.dataset.group || null;

        if (isParent) {
          const key = btn.dataset.parent!;
          const isOpen = subpanels.find((p) => p.dataset.group === key)?.classList.contains('open');
          // 열린 상위를 다시 누르면 접는다 (필터는 그대로)
          openOnly(toggleParent && isOpen ? null : key);
        } else {
          // 하위는 자기 상위를 연 채로 두고, 단일·전체는 모두 닫는다
          openOnly(ownerKey);
        }

        parentBtns.forEach((b) => b.classList.remove('has-active'));
        if (ownerKey) parentBtns.find((b) => b.dataset.parent === ownerKey)?.classList.add('has-active');

        filterBtns.forEach((b) => b.classList.remove('active'));
        btn.classList.add('active');
        activeCategory = btn.dataset.category || 'all';
        activeIdx = filterBtns.indexOf(btn);
      }

      filterBtns.forEach((btn) => {
        btn.addEventListener(
          'click',
          () => {
            selectFilter(btn, { toggleParent: true });
            shown = BATCH;
            render();
          },
          { signal },
        );
      });

      // 뒤로 가기로 돌아왔을 때만 필터·펼친 개수·위치를 되살린다
      const saved = isBackForward() ? readState() : null;
      if (!saved) writeState(null);
      if (saved && filterBtns[saved.filterIdx]) {
        selectFilter(filterBtns[saved.filterIdx], { toggleParent: false });
        shown = Math.max(BATCH, saved.shown);
      }
      render();
      if (saved) {
        if ('scrollRestoration' in history) history.scrollRestoration = 'manual';
        requestAnimationFrame(() => window.scrollTo(0, saved.y));
      }

      window.addEventListener(
        'pagehide',
        () => writeState({ filterIdx: activeIdx, shown, y: window.scrollY }),
        { signal },
      );

      observer = new IntersectionObserver(
        (entries) => {
          if (entries.some((e) => e.isIntersecting)) loadMore();
        },
        { rootMargin: '0px 0px 600px 0px' },
      );
      observer.observe(sentinel);
      signal.addEventListener('abort', () => observer?.disconnect());
    }

    // 첫 로드와 페이지 전환 모두에서 실행한다 (리스너는 AbortController로 한 벌만 남긴다)
    initBlogFilter();
    document.addEventListener('astro:page-load', initBlogFilter);
  </script>
</BaseLayout>
