---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PostList from '../../components/PostList.astro';
import { base } from '../../lib/config';
import { getPublishedPosts, isCertPost } from '../../lib/posts';
import { TOPICS } from '../../data/topics';

// 모든 글을 최신순 한 줄 목록으로 둔다. 자격증 공부 글은 이 목록에서 빼고 주제 목록(자격증 공부)에서만 보인다.
const posts = await getPublishedPosts();
const latest = posts.filter((p) => !isCertPost(p));

const topicOptions = TOPICS.map((t) => ({
  id: t.id as string,
  name: t.name,
  count: posts.filter((p) => (p.data.topics as string[]).includes(t.id)).length,
})).filter((o) => o.count > 0);
---

<BaseLayout title="스토리 — IT Oasis">
  <h1 class="text-[28px] sm:text-[32px] font-bold leading-[1.3] tracking-[-0.02em]">스토리</h1>
  <p class="mt-2 text-[14.5px] text-gray-500 dark:text-gray-400">{latest.length}편</p>

  <nav class="text-links mt-5" aria-label="주제 고르기">
    <a href={`${base}/blog`} class="is-active" aria-current="page">전체</a>
    {topicOptions.map((o) => <a href={`${base}/topics/${o.id}`}>{o.name} {o.count}</a>)}
  </nav>

  <PostList posts={latest} />
</BaseLayout>
