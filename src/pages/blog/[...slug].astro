---
import BaseLayout from '../../layouts/BaseLayout.astro';
import BlogSidebar from '../../components/BlogSidebar.astro';
import AuthorCard from '../../components/AuthorCard.astro';
import Giscus from '../../components/Giscus.astro';
import SeriesNav from '../../components/SeriesNav.astro';
import { render } from 'astro:content';
import { getReadingTime, parseCategory, translateCategory } from '../../lib/utils';
import { base, assetPath, getCategoryDisplayKo } from '../../lib/config';
import { TAG_COLORS, CAT_COLOR_MAP } from '../../lib/constants';
import { getBuildablePosts, getPublishedPosts } from '../../lib/posts';

export async function getStaticPaths() {
  // Build a page for every non-draft post (unlisted included, so direct links work)...
  const buildable = await getBuildablePosts();
  // ...but only ever surface publicly-listed posts as prev/next/related.
  const posts = await getPublishedPosts();

  return buildable.map((post) => {
    const fullCat = post.data.category;
    const parentCat = parseCategory(fullCat).parent;

    // Same subcategory only — these are the posts shown under the "'<category>' 의 다른 글" header.
    // Don't pad with parent-category siblings here, or the header mislabels other categories
    // (e.g. a Byeolchi post showing Balruno posts under "'프로젝트/별찌' 의 다른 글").
    let relatedPosts = posts
      .filter((p) => p.id !== post.id && p.data.category === fullCat)
      .slice(0, 4);
    const isSameCategory = relatedPosts.length > 0;

    // Fallbacks (rendered under the generic "다른 글 둘러보기" header): same parent category, then recent.
    if (!isSameCategory) {
      relatedPosts = posts
        .filter((p) => p.id !== post.id && parseCategory(p.data.category).parent === parentCat)
        .slice(0, 4);
      if (relatedPosts.length === 0) {
        relatedPosts = posts.filter((p) => p.id !== post.id).slice(0, 4);
      }
    }

    // Unlisted posts sit outside the public sequence, so they get no prev/next.
    const pubIndex = posts.findIndex((p) => p.id === post.id);
    const prevPost = pubIndex >= 0 ? posts[pubIndex + 1] || null : null;
    const nextPost = pubIndex >= 0 ? posts[pubIndex - 1] || null : null;

    return {
      params: { slug: post.id },
      props: {
        post,
        prevPost,
        nextPost,
        relatedPosts,
        isSameCategory,
      },
    };
  });
}

const { post, prevPost, nextPost, relatedPosts, isSameCategory } = Astro.props;
const { Content, headings } = await render(post);
const readingTime = getReadingTime(post.body || '');

const formattedDate = post.data.date.toLocaleDateString('ko-KR', {
  year: 'numeric',
  month: 'long',
  day: 'numeric',
});

const tocHeadings = headings.filter((h) => h.depth <= 3);
const hasToc = tocHeadings.length > 2;

const catDisplayKo = getCategoryDisplayKo();
const categoryKo = translateCategory(post.data.category, catDisplayKo);
---

<BaseLayout title={post.data.title} description={post.data.description} ogImage={post.data.coverImage ? assetPath(post.data.coverImage) : undefined} noindex={post.data.unlisted}>
  <div class="fade-in-up">
      <!-- Main content -->
      <article class="post-article relative">
      <!-- Floating left sidebar (outside content area, like TOC on right) -->
      <div class="floating-sidebar hidden xl:block">
        <BlogSidebar activeCategory={post.data.category} />
      </div>
      <!-- Back link -->
      <a href={`${base}/blog`} class="group inline-flex items-center gap-1.5 text-[12px] sm:text-[13px] text-gray-400 dark:text-gray-500 hover:text-primary dark:hover:text-primary-light transition-all duration-300 mb-8 sm:mb-10">
        <svg class="w-3.5 h-3.5 group-hover:-translate-x-1 transition-transform duration-300" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
          <path stroke-linecap="round" stroke-linejoin="round" d="M15 19l-7-7 7-7" />
        </svg>
        <span>모든 글</span>
      </a>

      <!-- Post header -->
      <header class="mb-8 sm:mb-10">
        <div class="flex flex-wrap items-center gap-2.5 sm:gap-3 mb-4 sm:mb-5">
          <time class="text-[13px] sm:text-[14px] font-medium text-gray-500 dark:text-gray-400">
            {formattedDate}
          </time>
          <span class="w-1 h-1 rounded-full bg-gray-300 dark:bg-gray-600"></span>
          <span class="text-[13px] sm:text-[14px] text-gray-500 dark:text-gray-400">
            <span>{`약 ${readingTime}분 분량`}</span>
          </span>
          <span id="post-views-dot" class="hidden w-1 h-1 rounded-full bg-gray-300 dark:bg-gray-600"></span>
          <span id="post-views" class="hidden items-center gap-1 text-[13px] sm:text-[14px] text-gray-500 dark:text-gray-400">
            <svg class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
              <path stroke-linecap="round" stroke-linejoin="round" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z" />
              <path stroke-linecap="round" stroke-linejoin="round" d="M2.458 12C3.732 7.943 7.523 5 12 5c4.478 0 8.268 2.943 9.542 7-1.274 4.057-5.064 7-9.542 7-4.477 0-8.268-2.943-9.542-7z" />
            </svg>
            <span id="post-views-count">—</span>
          </span>
          <span class="w-1 h-1 rounded-full bg-gray-300 dark:bg-gray-600"></span>
          <a href={`${base}/categories/${post.data.category.split('/').map(s => encodeURIComponent(s)).join('/')}`} class:list={['category-pill', CAT_COLOR_MAP[parseCategory(post.data.category).parent] || 'cat-default']}>
            {categoryKo}
          </a>
        </div>
        <h1 id="post-title" class="text-xl sm:text-2xl md:text-3xl font-bold tracking-[-0.02em] leading-tight mb-4 sm:mb-5">
          {post.data.title}
        </h1>
        <div class="flex flex-wrap items-center gap-1.5">
          {post.data.tags.length > 0 && (
            post.data.tags.map((tag: string, i: number) => (
              <a href={`${base}/tags/${encodeURIComponent(tag)}`} class:list={['tag-pill text-[10px] sm:text-[11px]', TAG_COLORS[i % TAG_COLORS.length]]}>
                {tag}
              </a>
            ))
          )}
        </div>
      </header>

      <!-- Cover image -->
      {post.data.coverImage && (
        <div class="mb-8 sm:mb-10 rounded-2xl overflow-hidden">
          <img src={assetPath(post.data.coverImage)} alt="" class="w-full max-h-96 object-contain" loading="lazy" />
        </div>
      )}

      <!-- Divider -->
      <div class="divider mb-8 sm:mb-10"></div>

      <!-- Series navigation (auto-rendered when frontmatter has `series`) -->
      {post.data.series && (
        <SeriesNav currentPostId={post.id} series={post.data.series} />
      )}

      <!-- Inline TOC (mobile only when sidebar exists) -->
      {hasToc && (
        <details class="xl:hidden glass-card rounded-2xl p-6 mb-8 group" open>
          <summary class="flex items-center justify-between cursor-pointer text-[14px] font-semibold select-none">
            <div class="flex items-center gap-2">
              <svg class="w-4 h-4 text-primary" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                <path stroke-linecap="round" stroke-linejoin="round" d="M4 6h16M4 10h16M4 14h16M4 18h16" />
              </svg>
              <span>목차</span>
            </div>
            <svg class="w-4 h-4 text-gray-400 transform group-open:rotate-180 transition-transform duration-300" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
              <path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7" />
            </svg>
          </summary>
          <nav class="mt-4 space-y-1.5">
            {tocHeadings.map((heading, idx) => (
              <a
                href={`#${heading.slug}`}
                class:list={[
                  'toc-item block text-[13px] text-gray-500 dark:text-gray-400 hover:text-primary dark:hover:text-primary-light transition-colors duration-300 py-1',
                  heading.depth === 3 && 'pl-4',
                ]}
              >
                {heading.text}
              </a>
            ))}
          </nav>
        </details>
      )}

      <!-- Post content -->
      <div class="reading-surface rounded-2xl sm:rounded-3xl p-5 sm:p-7 md:p-10">
        <div id="post-content" class="prose">
          <Content />
        </div>
      </div>

      <!-- Author profile -->
      <div class="mt-10 sm:mt-14">
        <AuthorCard />
      </div>

      <!-- Related posts -->
      {relatedPosts.length > 0 && (
        <div class="related-card mt-6 sm:mt-8">
          <div class="p-6 sm:p-8 md:p-10">
            <p class="text-[15px] sm:text-[16px] font-bold tracking-tight mb-5">
              {isSameCategory ? (
                <>
                  <span class="text-gray-700 dark:text-gray-200">'{categoryKo}'</span>
                  <span class="text-gray-500 dark:text-gray-400"> 의 다른 글</span>
                </>
              ) : (
                <span class="text-gray-700 dark:text-gray-200">다른 글 둘러보기</span>
              )}
            </p>
            <div class="h-px bg-gray-200/80 dark:bg-gray-700/50 mb-5"></div>
            <div class="flex flex-col gap-2.5">
              {relatedPosts.map((rp) => (
                <a href={`${base}/blog/${rp.id}`} class="related-post-link group flex items-center justify-between gap-4">
                  <p class="text-[14px] sm:text-[15px] font-semibold text-gray-700 dark:text-gray-200 group-hover:text-primary dark:group-hover:text-primary-light transition-colors duration-300 truncate">
                    {rp.data.title}
                  </p>
                  <span class="text-[18px] text-gray-400 dark:text-gray-500 group-hover:text-primary dark:group-hover:text-primary-light group-hover:translate-x-1 transition-all duration-300 shrink-0 leading-none">&rarr;</span>
                </a>
              ))}
            </div>
          </div>
        </div>
      )}

      <!-- Prev / Next navigation -->
      {(prevPost || nextPost) && (
        <nav class="mt-8 grid grid-cols-1 sm:grid-cols-2 gap-3">
          {prevPost ? (
            <a href={`${base}/blog/${prevPost.id}`} class="glass-card rounded-2xl p-4 sm:p-5 group flex items-center gap-3.5">
              <span class="prevnext-arrow shrink-0">
                <svg class="w-4 h-4 transition-transform duration-300 group-hover:-translate-x-0.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M15 19l-7-7 7-7" />
                </svg>
              </span>
              <span class="min-w-0">
                <span class="block text-[11px] font-bold text-gray-400 dark:text-gray-500 tracking-widest uppercase mb-1">이전 글</span>
                <span class="block text-[14px] sm:text-[15px] font-semibold text-gray-700 dark:text-gray-200 group-hover:text-primary dark:group-hover:text-primary-light transition-colors duration-300 line-clamp-1">
                  {prevPost.data.title}
                </span>
              </span>
            </a>
          ) : <div />}
          {nextPost ? (
            <a href={`${base}/blog/${nextPost.id}`} class="glass-card rounded-2xl p-4 sm:p-5 group flex items-center gap-3.5 text-right">
              <span class="min-w-0 ml-auto">
                <span class="block text-[11px] font-bold text-gray-400 dark:text-gray-500 tracking-widest uppercase mb-1">다음 글</span>
                <span class="block text-[14px] sm:text-[15px] font-semibold text-gray-700 dark:text-gray-200 group-hover:text-primary dark:group-hover:text-primary-light transition-colors duration-300 line-clamp-1">
                  {nextPost.data.title}
                </span>
              </span>
              <span class="prevnext-arrow shrink-0">
                <svg class="w-4 h-4 transition-transform duration-300 group-hover:translate-x-0.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M9 5l7 7-7 7" />
                </svg>
              </span>
            </a>
          ) : <div />}
        </nav>
      )}

      <!-- Comments -->
      <Giscus />

      <!-- Sidebar TOC (desktop only, floating right of article) -->
      {hasToc && (
        <aside class="hidden xl:block floating-toc">
          <div class="sticky top-24">
            <div class="glass-sidebar p-5">
              <div class="flex items-center gap-2 mb-4">
                <svg class="w-3.5 h-3.5 text-primary" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M4 6h16M4 10h16M4 14h16M4 18h16" />
                </svg>
                <span class="text-[13px] font-semibold tracking-wide uppercase text-gray-500 dark:text-gray-400">목차</span>
              </div>

              <!-- Progress bar -->
              <div class="h-px w-full bg-gray-200/50 dark:bg-gray-700/30 mb-4 rounded-full overflow-hidden">
                <div id="toc-progress" class="h-full bg-gradient-to-r from-primary to-accent rounded-full transition-all duration-300" style="width: 0%"></div>
              </div>

              <nav id="sidebar-toc" class="space-y-0.5 toc-scroll">
                {tocHeadings.map((heading, idx) => (
                  <a
                    href={`#${heading.slug}`}
                    data-heading={heading.slug}
                    class:list={[
                      'toc-link block text-[13px] leading-relaxed py-1.5 rounded-lg transition-all duration-300 text-gray-700 dark:text-gray-300 hover:text-primary dark:hover:text-primary-light',
                      heading.depth === 2 && 'pl-2',
                      heading.depth === 3 && 'pl-5',
                    ]}
                  >
                    {heading.text}
                  </a>
                ))}
              </nav>
            </div>
          </div>
        </aside>
      )}
    </article>
  </div>
</BaseLayout>

<style>
  /* Each related post = a distinct, clearly separated row chip */
  .related-post-link {
    padding: 0.8rem 1rem;
    border-radius: 13px;
    background: rgba(255, 255, 255, 0.55);
    border: 1px solid rgba(15, 40, 80, 0.07);
    box-shadow: inset 0 1px 1px rgba(255, 255, 255, 0.7);
    transition: background 0.25s ease, border-color 0.25s ease, transform 0.25s ease;
  }

  .related-post-link:hover {
    background: rgba(56, 189, 248, 0.1);
    border-color: rgba(56, 189, 248, 0.3);
    transform: translateX(2px);
  }

  :global(.dark) .related-post-link {
    background: rgba(255, 255, 255, 0.04);
    border-color: rgba(255, 255, 255, 0.08);
    box-shadow: inset 0 1px 1px rgba(255, 255, 255, 0.05);
  }

  :global(.dark) .related-post-link:hover {
    background: rgba(56, 189, 248, 0.14);
    border-color: rgba(56, 189, 248, 0.3);
  }

  /* Prev / Next circular arrow */
  .prevnext-arrow {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 38px;
    height: 38px;
    border-radius: 50%;
    color: #0284c7;
    background: rgba(56, 189, 248, 0.12);
    transition: background 0.3s ease;
  }

  .group:hover .prevnext-arrow {
    background: rgba(56, 189, 248, 0.22);
  }

  :global(.dark) .prevnext-arrow {
    color: #7dd3fc;
    background: rgba(56, 189, 248, 0.14);
  }

  :global(.dark) .group:hover .prevnext-arrow {
    background: rgba(56, 189, 248, 0.24);
  }

  .related-card {
    background: linear-gradient(150deg, rgba(255, 255, 255, 0.86) 0%, rgba(236, 246, 255, 0.62) 100%);
    border: 1px solid rgba(15, 40, 80, 0.08);
    backdrop-filter: blur(22px) saturate(170%);
    -webkit-backdrop-filter: blur(22px) saturate(170%);
    border-radius: 1.25rem;
    box-shadow:
      0 8px 28px rgba(15, 40, 80, 0.06),
      0 1px 3px rgba(15, 40, 80, 0.05),
      inset 0 1px 1px rgba(255, 255, 255, 0.9);
  }

  :global(.dark) .related-card {
    background: linear-gradient(150deg, rgba(255, 255, 255, 0.07) 0%, rgba(80, 140, 200, 0.045) 100%);
    border-color: rgba(255, 255, 255, 0.1);
    box-shadow:
      0 8px 28px rgba(0, 0, 0, 0.28),
      inset 0 1px 1px rgba(255, 255, 255, 0.1);
  }

  .floating-sidebar {
    position: absolute;
    top: 0;
    bottom: 0;
    right: 100%;
    margin-right: 3.5rem;
    width: 15rem;
  }

  @media (min-width: 1536px) {
    .floating-sidebar {
      margin-right: 4.5rem;
    }
  }

  .floating-toc {
    position: absolute;
    top: 0;
    bottom: 0;
    left: 100%;
    margin-left: 2rem;
    width: 260px;
  }

  @media (min-width: 1536px) {
    .floating-toc {
      width: 300px;
      margin-left: 2.5rem;
    }
  }

  .toc-scroll {
    max-height: calc(100vh - 14rem);
    overflow-y: auto;
    /* Hidden by default; revealed only while scrolling (or hovering) */
    scrollbar-width: thin;
    scrollbar-color: transparent transparent;
    transition: scrollbar-color 0.35s ease;
  }

  .toc-scroll:hover,
  .toc-scroll.is-scrolling {
    scrollbar-color: rgba(156, 163, 175, 0.4) transparent;
  }

  .toc-scroll::-webkit-scrollbar {
    width: 6px;
  }

  .toc-scroll::-webkit-scrollbar-track {
    background: transparent;
  }

  .toc-scroll::-webkit-scrollbar-thumb {
    background: transparent;
    border-radius: 100px;
    transition: background 0.35s ease;
  }

  .toc-scroll:hover::-webkit-scrollbar-thumb,
  .toc-scroll.is-scrolling::-webkit-scrollbar-thumb {
    background: rgba(156, 163, 175, 0.45);
  }

  :global(.dark) .toc-scroll:hover::-webkit-scrollbar-thumb,
  :global(.dark) .toc-scroll.is-scrolling::-webkit-scrollbar-thumb {
    background: rgba(148, 163, 184, 0.4);
  }
</style>

<script>
  function initToc() {
    const allTocLinks = document.querySelectorAll<HTMLAnchorElement>('.toc-link');
    const progressBar = document.getElementById('toc-progress');
    if (allTocLinks.length === 0) return;

    // Only observe visible (non-hidden) TOC links
    const visibleLinks = Array.from(allTocLinks).filter((l) => !l.classList.contains('hidden'));
    const headingEls = visibleLinks.map((link) => {
      const slug = link.getAttribute('data-heading');
      return slug ? document.getElementById(slug) : null;
    }).filter(Boolean) as HTMLElement[];

    if (headingEls.length === 0) return;

    const observer = new IntersectionObserver(
      (entries) => {
        entries.forEach((entry) => {
          if (entry.isIntersecting) {
            const id = entry.target.id;

            allTocLinks.forEach((link) => {
              const isActive = link.getAttribute('data-heading') === id;
              if (isActive) {
                link.classList.add('text-primary', 'dark:text-primary-light', 'font-medium', 'bg-primary/[0.04]');
                link.classList.remove('text-gray-500', 'dark:text-gray-400');
                // Auto-scroll TOC nav so active item stays visible
                const tocNav = link.closest('.toc-scroll');
                if (tocNav && tocNav.scrollHeight > tocNav.clientHeight) {
                  link.scrollIntoView({ block: 'nearest', behavior: 'smooth' });
                }
              } else {
                link.classList.remove('text-primary', 'dark:text-primary-light', 'font-medium', 'bg-primary/[0.04]');
                link.classList.add('text-gray-500', 'dark:text-gray-400');
              }
            });

            if (progressBar) {
              const idx = headingEls.findIndex((el) => el.id === id);
              const pct = ((idx + 1) / headingEls.length) * 100;
              progressBar.style.width = `${pct}%`;
            }
          }
        });
      },
      { rootMargin: '-80px 0px -60% 0px', threshold: 0.1 }
    );

    headingEls.forEach((el) => observer.observe(el));

    // Re-init when language changes
    (window as any).__tocObserver?.disconnect();
    (window as any).__tocObserver = observer;
  }

  (window as any).initTocFn = initToc;
  initToc();
  document.addEventListener('astro:page-load', initToc);
</script>

<script>
  const GC_HOST = 'https://itoasis.goatcounter.com';

  function loadPostViews() {
    const el = document.getElementById('post-views-count');
    const wrapper = document.getElementById('post-views');
    const dot = document.getElementById('post-views-dot');
    if (!el || !wrapper) return;

    // GoatCounter records the full pathname (including base path)
    const pagePath = window.location.pathname.replace(/\/$/, '') || '/';

    fetch(`${GC_HOST}/counter/${encodeURIComponent(pagePath)}.json`)
      .then(r => r.json())
      .then(data => {
        el.textContent = data.count;
        wrapper.classList.remove('hidden');
        wrapper.classList.add('inline-flex');
        if (dot) dot.classList.remove('hidden');
      })
      .catch(() => {
        // No views yet or API error — keep hidden
      });
  }

  loadPostViews();
  document.addEventListener('astro:page-load', loadPostViews);
</script>

