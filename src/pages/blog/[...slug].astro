---
import BaseLayout from '../../layouts/BaseLayout.astro';
import AuthorCard from '../../components/AuthorCard.astro';
import Giscus from '../../components/Giscus.astro';
import SeriesNav from '../../components/SeriesNav.astro';
import HubMap from '../../components/HubMap.astro';
import HubDomainList from '../../components/HubDomainList.astro';
import { OVERVIEW_ID } from '../../data/be-commerce-hub';
import { render } from 'astro:content';
import { getReadingTime, parseCategory, translateCategory } from '../../lib/utils';
import { base, assetPath, getCategoryDisplayKo } from '../../lib/config';
import { buildProjectLookup, getBuildablePosts, getPublishedPosts } from '../../lib/posts';
import { topicName } from '../../data/topics';

export async function getStaticPaths() {
  const buildable = await getBuildablePosts();

  // 태그·카테고리 목록 페이지는 <공개된> 글로만 만들어진다(getPublishedPosts).
  // 그런데 이 페이지는 unlisted 글도 만든다 — 링크로 들어올 수 있어야 하니까.
  // 그래서 unlisted 글에만 달린 태그·카테고리를 그냥 링크로 그리면 404로 간다.
  // 실제로 태그 19개와 카테고리 portfolio 가 그렇게 죽어 있었다.
  // 여기서 <페이지가 실제로 생기는> 태그·카테고리를 미리 모아 두고, 없는 것은 링크로 안 그린다.
  const published = await getPublishedPosts();
  const projectLookup = buildProjectLookup(published);
  const linkableTags = new Set(published.flatMap((p) => p.data.tags));
  const linkableCategories = new Set<string>();
  for (const p of published) {
    const full = p.data.category;
    if (!full) continue;
    linkableCategories.add(full);
    linkableCategories.add(parseCategory(full).parent);
  }

  return buildable.map((post) => {
    const fullCat = post.data.category;
    // 관련 글과 이전·다음 글은 프로젝트가 아니라 대표 주제(topics 의 첫 항목)로 묶는다.
    // 주제가 없는 글(목록에 안 나오는 포트폴리오 글)은 묶을 무리가 없어 둘 다 비운다.
    const topic: string | undefined = post.data.topics[0];
    const sameTopic = topic ? published.filter((p) => (p.data.topics as string[]).includes(topic)) : [];

    // 한 주제에 수십 편이 걸려서 최신순으로 자르면 어느 글에서나 같은 네 편이 나온다.
    // 겹치는 태그가 많은 글을 먼저, 같으면 작성일이 가까운 글을 먼저 고른다.
    // 같은 시리즈의 글은 본문 위 시리즈 목록에 이미 있으므로 맨 뒤로 보낸다. 다른 프로젝트의 같은 주제 글이 먼저 보인다.
    const ownTags = new Set(post.data.tags);
    const ownDate = post.data.date.valueOf();
    const relatedPosts = sameTopic
      .filter((p) => p.id !== post.id)
      .map((p) => ({
        p,
        sameSeries: post.data.series && p.data.series === post.data.series ? 1 : 0,
        shared: p.data.tags.filter((t: string) => ownTags.has(t)).length,
        gap: Math.abs(p.data.date.valueOf() - ownDate),
      }))
      .sort((x, y) => x.sameSeries - y.sameSeries || y.shared - x.shared || x.gap - y.gap)
      .slice(0, 4)
      .map((x) => x.p);

    // Unlisted posts sit outside the sequence, so they get no prev/next.
    const pubIndex = sameTopic.findIndex((p) => p.id === post.id);
    const prevPost = pubIndex >= 0 ? sameTopic[pubIndex + 1] || null : null;
    const nextPost = pubIndex >= 0 ? sameTopic[pubIndex - 1] || null : null;

    // 프로젝트에서 나온 글은 위쪽 돌아가기 링크가 그 프로젝트로 간다. 소개 글 자신은 프로젝트 목록으로 간다.
    const project = projectLookup.get(fullCat) || null;
    const backLink = !project
      ? { href: '/blog', label: '모든 글' }
      : project.storyId === post.id && project.href === `/blog/${post.id}`
        ? { href: '/projects', label: '프로젝트' }
        : { href: project.href, label: `${project.title} 프로젝트` };

    return {
      params: { slug: post.id },
      props: {
        post,
        prevPost,
        nextPost,
        relatedPosts,
        backLink,
        categoryHasPage: linkableCategories.has(fullCat),
        linkableTags: post.data.tags.filter((tag: string) => linkableTags.has(tag)),
      },
    };
  });
}

const { post, prevPost, nextPost, relatedPosts, backLink, categoryHasPage, linkableTags } = Astro.props;
const { Content, headings } = await render(post);
const readingTime = getReadingTime(post.body || '');

const formattedDate = post.data.date.toLocaleDateString('ko-KR', {
  year: 'numeric',
  month: 'long',
  day: 'numeric',
});

const tocHeadings = headings.filter((h) => h.depth <= 3);
const hasToc = tocHeadings.length > 2;

const catDisplayKo = getCategoryDisplayKo();
const categoryKo = translateCategory(post.data.category, catDisplayKo);
const topics: string[] = post.data.topics;
---

<BaseLayout title={post.data.title} description={post.data.description} ogImage={post.data.coverImage ? assetPath(post.data.coverImage) : undefined} noindex={post.data.unlisted}>
  <article class="post-article relative">
    <a href={`${base}${backLink.href}`} class="post-back">&larr; {backLink.label}</a>

    <header class="mt-6 mb-10">
      <p class="post-meta">
        <time datetime={post.data.date.toISOString().slice(0, 10)}>{formattedDate}</time>
        {post.id !== OVERVIEW_ID && (
          <>
            <span aria-hidden="true">&middot;</span>
            <span>{`약 ${readingTime}분 분량`}</span>
          </>
        )}
        <span id="post-views" class="hidden">
          <span aria-hidden="true">&middot;</span>
          <span>조회 <span id="post-views-count">&middot;</span></span>
        </span>
        {topics.length > 0 ? (
          topics.map((id) => (
            <>
              <span aria-hidden="true">&middot;</span>
              <a href={`${base}/topics/${id}`}>{topicName(id)}</a>
            </>
          ))
        ) : (
          <>
            <span aria-hidden="true">&middot;</span>
            {categoryHasPage ? (
              <a href={`${base}/categories/${post.data.category.split('/').map(s => encodeURIComponent(s)).join('/')}`}>{categoryKo}</a>
            ) : (
              <span>{categoryKo}</span>
            )}
          </>
        )}
      </p>
      <h1 id="post-title" class="post-title">{post.data.title}</h1>
      {post.data.tags.length > 0 && (
        <p class="post-tags">
          {post.data.tags.map((tag: string) => (
            !linkableTags.includes(tag) ? (
              <span>#{tag}</span>
            ) : (
              <a href={`${base}/tags/${encodeURIComponent(tag)}`}>#{tag}</a>
            )
          ))}
        </p>
      )}
    </header>

    <!-- 시리즈 목록(frontmatter 에 `series` 가 있으면 자동). BE-commerce 개요 글은 프로젝트 첫 화면이라 영역 지도를 둔다. -->
    {post.id === OVERVIEW_ID ? (
      <HubMap />
    ) : post.data.series && (
      <SeriesNav currentPostId={post.id} series={post.data.series} />
    )}

    <!-- 목차(xl 미만). 긴 글은 접어 둔다 -->
    {hasToc && (
      <details class="xl:hidden toc-inline" open={tocHeadings.length <= 20}>
        <summary>목차</summary>
        <nav>
          {tocHeadings.map((heading) => (
            <a href={`#${heading.slug}`} class:list={['toc-item', heading.depth === 3 && 'toc-item--sub']}>
              {heading.text}
            </a>
          ))}
        </nav>
      </details>
    )}

    <div id="post-content" class="prose">
      <Content />
    </div>

    {post.id === OVERVIEW_ID && <HubDomainList />}

    <div class="rule-top">
      <AuthorCard />
    </div>

    {relatedPosts.length > 0 && (
      <section class="rule-top">
        <h2 class="link-list-head">'{topicName(topics[0])}' 의 다른 글</h2>
        <ul class="link-list">
          {relatedPosts.map((rp) => (
            <li><a href={`${base}/blog/${rp.id}`}>{rp.data.title}</a></li>
          ))}
        </ul>
      </section>
    )}

    {(prevPost || nextPost) && (
      <nav class={relatedPosts.length > 0 ? 'mt-8' : 'rule-top'} aria-label="이전 글과 다음 글">
        <ul class="link-list">
          {prevPost && (
            <li><span class="link-list-label">이전 글</span><a href={`${base}/blog/${prevPost.id}`}>{prevPost.data.title}</a></li>
          )}
          {nextPost && (
            <li><span class="link-list-label">다음 글</span><a href={`${base}/blog/${nextPost.id}`}>{nextPost.data.title}</a></li>
          )}
        </ul>
      </nav>
    )}

    <Giscus />

    <!-- 목차(xl 이상): 본문 오른쪽 바깥 여백에 붙는다 -->
    {hasToc && (
      <aside class="hidden xl:block floating-toc" aria-label="목차">
        <div class="sticky top-20">
          <p class="toc-title">목차</p>
          <nav id="sidebar-toc" class="toc-scroll">
            {tocHeadings.map((heading) => (
              <a
                href={`#${heading.slug}`}
                data-heading={heading.slug}
                class:list={['toc-link', heading.depth === 3 && 'toc-link--sub']}
              >
                {heading.text}
              </a>
            ))}
          </nav>
        </div>
      </aside>
    )}
  </article>
</BaseLayout>

<style>
  .post-back {
    display: inline-block;
    font-size: 14px;
    color: #59636e;
    text-decoration: none;
  }
  .post-back:hover { color: #1a6aa0; text-decoration: underline; text-underline-offset: 3px; }
  :global(.dark) .post-back { color: #8b949e; }
  :global(.dark) .post-back:hover { color: #8db8d0; }

  .post-meta {
    display: flex;
    flex-wrap: wrap;
    gap: 0 0.5rem;
    margin: 0 0 0.9rem;
    font-size: 14px;
    line-height: 1.7;
    color: #59636e;
  }
  .post-meta a { color: inherit; text-decoration: none; }
  .post-meta a:hover { color: #1a6aa0; text-decoration: underline; text-underline-offset: 3px; }
  #post-views.hidden { display: none; }
  #post-views:not(.hidden) { display: inline-flex; gap: 0.5rem; }
  :global(.dark) .post-meta { color: #8b949e; }
  :global(.dark) .post-meta a:hover { color: #8db8d0; }

  .post-title {
    margin: 0;
    font-size: 26px;
    font-weight: 700;
    line-height: 1.3;
    letter-spacing: -0.02em;
    color: #1f2328;
    text-wrap: balance;
  }
  @media (min-width: 640px) {
    .post-title { font-size: 32px; }
  }
  :global(.dark) .post-title { color: #f0f6fc; }

  .post-tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.1rem 0.9rem;
    margin: 1rem 0 0;
    font-size: 14px;
    color: #59636e;
  }
  .post-tags a { color: inherit; text-decoration: none; }
  .post-tags a:hover { color: #1a6aa0; text-decoration: underline; text-underline-offset: 3px; }
  :global(.dark) .post-tags { color: #8b949e; }
  :global(.dark) .post-tags a:hover { color: #8db8d0; }

  /* 목차(xl 미만) */
  .toc-inline {
    margin: 0 0 2rem;
    padding: 0.75rem 0;
    border-top: 1px solid #d1d9e0;
    border-bottom: 1px solid #d1d9e0;
  }
  :global(.dark) .toc-inline { border-color: #3d444d; }
  .toc-inline summary {
    cursor: pointer;
    font-size: 14px;
    font-weight: 700;
    color: #1f2328;
  }
  :global(.dark) .toc-inline summary { color: #e6edf3; }
  .toc-inline nav { margin-top: 0.6rem; display: flex; flex-direction: column; }
  .toc-item {
    padding: 0.3rem 0;
    font-size: 14px;
    line-height: 1.5;
    color: #59636e;
    text-decoration: none;
  }
  .toc-item--sub { padding-left: 1rem; }
  .toc-item:hover { color: #1a6aa0; text-decoration: underline; text-underline-offset: 3px; }
  :global(.dark) .toc-item { color: #9198a1; }
  :global(.dark) .toc-item:hover { color: #8db8d0; }

  /* 목차(xl 이상): 본문(720px) 오른쪽 바깥 여백. 본문 폭은 목차 유무와 무관하다 */
  .floating-toc {
    position: absolute;
    top: 0;
    bottom: 0;
    left: 100%;
    margin-left: 1.5rem;
    width: 220px;
  }
  .toc-title {
    margin: 0 0 0.5rem;
    font-size: 13px;
    font-weight: 700;
    color: #59636e;
  }
  :global(.dark) .toc-title { color: #8b949e; }
  .toc-scroll {
    max-height: calc(100vh - 9rem);
    overflow-y: auto;
    display: flex;
    flex-direction: column;
    scrollbar-width: thin;
  }
  .toc-link {
    padding: 0.25rem 0;
    font-size: 13px;
    line-height: 1.5;
    color: #59636e;
    text-decoration: none;
    word-break: keep-all;
  }
  .toc-link--sub { padding-left: 0.8rem; }
  .toc-link:hover { color: #1a6aa0; }
  .toc-link.is-active { font-weight: 700; color: #1f2328; }
  :global(.dark) .toc-link { color: #9198a1; }
  :global(.dark) .toc-link:hover { color: #8db8d0; }
  :global(.dark) .toc-link.is-active { color: #e6edf3; }
</style>

<script>
  function initToc() {
    const allTocLinks = document.querySelectorAll<HTMLAnchorElement>('.toc-link');
    const progressBar = document.getElementById('toc-progress');
    if (allTocLinks.length === 0) return;

    // Only observe visible (non-hidden) TOC links
    const visibleLinks = Array.from(allTocLinks).filter((l) => !l.classList.contains('hidden'));
    const headingEls = visibleLinks.map((link) => {
      const slug = link.getAttribute('data-heading');
      return slug ? document.getElementById(slug) : null;
    }).filter(Boolean) as HTMLElement[];

    if (headingEls.length === 0) return;

    const observer = new IntersectionObserver(
      (entries) => {
        entries.forEach((entry) => {
          if (entry.isIntersecting) {
            const id = entry.target.id;

            allTocLinks.forEach((link) => {
              const isActive = link.getAttribute('data-heading') === id;
              link.classList.toggle('is-active', isActive);
              if (isActive) {
                // Auto-scroll TOC nav so active item stays visible
                const tocNav = link.closest('.toc-scroll');
                if (tocNav && tocNav.scrollHeight > tocNav.clientHeight) {
                  link.scrollIntoView({ block: 'nearest', behavior: 'smooth' });
                }
              }
            });

            if (progressBar) {
              const idx = headingEls.findIndex((el) => el.id === id);
              const pct = ((idx + 1) / headingEls.length) * 100;
              progressBar.style.width = `${pct}%`;
            }
          }
        });
      },
      { rootMargin: '-80px 0px -60% 0px', threshold: 0.1 }
    );

    headingEls.forEach((el) => observer.observe(el));

    // Re-init when language changes
    (window as any).__tocObserver?.disconnect();
    (window as any).__tocObserver = observer;
  }

  (window as any).initTocFn = initToc;
  initToc();
  document.addEventListener('astro:page-load', initToc);
</script>

<script>
  const GC_HOST = 'https://itoasis.goatcounter.com';

  function loadPostViews() {
    const el = document.getElementById('post-views-count');
    const wrapper = document.getElementById('post-views');
    if (!el || !wrapper) return;

    // GoatCounter records the full pathname (including base path)
    const pagePath = window.location.pathname.replace(/\/$/, '') || '/';

    fetch(`${GC_HOST}/counter/${encodeURIComponent(pagePath)}.json`)
      .then(r => r.json())
      .then(data => {
        el.textContent = data.count;
        wrapper.classList.remove('hidden');
      })
      .catch(() => {
        // No views yet or API error — keep hidden
      });
  }

  loadPostViews();
  document.addEventListener('astro:page-load', loadPostViews);
</script>
