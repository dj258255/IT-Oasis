---
import BaseLayout from '../layouts/BaseLayout.astro';
import AuthorCard from '../components/AuthorCard.astro';
import PostList from '../components/PostList.astro';
import { getPublishedPosts, isCertPost } from '../lib/posts';
import { renderRichText } from '../lib/richtext';
import { base, getSiteSettings } from '../lib/config';

const siteSettings = getSiteSettings();
const aboutHtmlKo = renderRichText(siteSettings.aboutContentKo, base);
interface CareerItem { title: string; meta?: string; period?: string; details?: string[]; href?: string }
const career: { label: string; items: CareerItem[] }[] = siteSettings.careerKo || [];
const resolveHref = (href: string) => (href.startsWith('/') ? `${base}${href}` : href);

const posts = (await getPublishedPosts()).filter((p) => !isCertPost(p)).slice(0, 8);
---

<BaseLayout title="소개 — IT Oasis">
  <h1 class="text-[28px] sm:text-[32px] font-bold leading-[1.3] tracking-[-0.02em]">소개</h1>

  <div class="prose mt-8">
    <div set:html={aboutHtmlKo} />
  </div>

  {career.length > 0 && (
    <section class="rule-top">
      <h2 class="text-[22px] sm:text-[24px] font-bold tracking-[-0.015em] mb-6">{siteSettings.careerTitleKo || '이력'}</h2>
      {career.map((group) => (
        <div class="career-group">
          <h3 class="career-label">{group.label}</h3>
          <ul class="career-items">
            {group.items.map((item) => (
              <li class="career-item">
                <div class="career-head">
                  <p class="career-title">
                    {item.href ? (
                      <a href={resolveHref(item.href)} target={item.href.startsWith('/') ? undefined : '_blank'} rel={item.href.startsWith('/') ? undefined : 'noopener'}>{item.title}</a>
                    ) : item.title}
                  </p>
                  {item.period && <span class="career-period">{item.period}</span>}
                </div>
                {item.meta && <p class="career-meta">{item.meta}</p>}
                {item.details && item.details.length > 0 && (
                  <ul class="career-details">
                    {item.details.map((line) => <li>{line}</li>)}
                  </ul>
                )}
              </li>
            ))}
          </ul>
        </div>
      ))}
    </section>
  )}

  <section class="rule-top">
    <AuthorCard />
  </section>

  <section class="mt-12">
    <div class="flex items-baseline justify-between border-b border-[#d1d9e0] dark:border-[#3d444d] pb-2">
      <h2 class="text-[14px] font-bold text-gray-500 dark:text-gray-400">최근 글</h2>
      <a href={`${base}/blog`} class="text-[14px] text-primary hover:underline underline-offset-4">전체 보기</a>
    </div>
    <PostList posts={posts} byYear={false} />
  </section>
</BaseLayout>

<style>
  .career-group {
    display: grid;
    gap: 0.75rem;
    padding: 1.5rem 0;
    border-top: 1px solid #d1d9e0;
  }

  .career-group:first-child {
    padding-top: 0;
    border-top: none;
  }

  .career-group:last-child {
    padding-bottom: 0;
  }

  @media (min-width: 640px) {
    .career-group {
      grid-template-columns: 8rem 1fr;
      gap: 1.5rem;
    }
  }

  .career-label {
    font-size: 0.875rem;
    font-weight: 700;
    color: var(--color-primary);
    padding-top: 0.125rem;
  }

  .career-items {
    display: grid;
    gap: 1.25rem;
  }

  .career-head {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    justify-content: space-between;
    column-gap: 1rem;
    row-gap: 0.125rem;
  }

  .career-title {
    font-size: 1.0625rem;
    font-weight: 700;
    line-height: 1.5;
    overflow-wrap: anywhere;
  }

  .career-title a {
    text-decoration: underline;
    text-decoration-color: #9aa4ae;
    text-underline-offset: 0.2em;
  }

  .career-title a:hover {
    text-decoration-color: currentColor;
  }

  .career-period {
    font-size: 0.8125rem;
    font-weight: 600;
    font-variant-numeric: tabular-nums;
    color: #59636e;
    white-space: nowrap;
  }

  .career-meta {
    margin-top: 0.125rem;
    font-size: 0.875rem;
    color: #59636e;
  }

  .career-details {
    margin-top: 0.5rem;
    padding-left: 1.1rem;
    list-style: disc;
    font-size: 0.9375rem;
    line-height: 1.7;
    color: #1f2328;
  }

  :global(.dark) .career-period,
  :global(.dark) .career-meta { color: #8b949e; }
  :global(.dark) .career-details { color: #d1d7e0; }
</style>
