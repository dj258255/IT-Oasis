---
import { getPublishedPosts } from '../lib/posts';
import { base } from '../lib/config';
import HubSeriesNav from './HubSeriesNav.astro';
import { HUB_SERIES } from '../data/be-commerce-hub';

interface Props {
  currentPostId: string;
  series: string;
}

const { currentPostId, series } = Astro.props;
const allPosts = await getPublishedPosts();
const seriesPosts = allPosts
  .filter((p) => p.data.series === series)
  .sort((a, b) => {
    const orderA = a.data.seriesOrder ?? 999;
    const orderB = b.data.seriesOrder ?? 999;
    if (orderA !== orderB) return orderA - orderB;
    return a.data.date.valueOf() - b.data.date.valueOf();
  });

const total = seriesPosts.length;
const currentIndex = seriesPosts.findIndex((p) => p.id === currentPostId);
const currentNo = currentIndex >= 0 ? currentIndex + 1 : 0;
---

{/* `series` guards posts with no series at all (undefined would match every seriesless post).
    `> 1` hides the nav on a series that has been merged down to a single post. */}
{/* 허브가 있는 시리즈는 번호순 목록 대신 영역 지도로 보여 준다. */}
{series === HUB_SERIES ? (
  <HubSeriesNav currentPostId={currentPostId} />
) : series && seriesPosts.length > 1 && (
  <aside class="series-nav">
    <div class="series-nav-head">
      <div class="series-nav-titlewrap">
        <svg class="series-nav-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <path d="M4 6h16M4 12h16M4 18h10" />
        </svg>
        <strong class="series-nav-title">{series} 시리즈</strong>
      </div>
      {currentNo > 0 && (
        <span class="series-nav-count">
          <span class="series-nav-count-now">{currentNo}</span><span class="series-nav-count-sep">/</span>{total}
          <span class="series-nav-count-unit">편</span>
        </span>
      )}
    </div>

    <ol class="series-nav-list">
      {seriesPosts.map((p, i) => {
        const isCurrent = p.id === currentPostId;
        const titleKo = p.data.title;
        const no = i + 1;
        return (
          <li class:list={['series-item', isCurrent && 'is-current']}>
            {isCurrent ? (
              <span class="series-link" aria-current="true">
                <span class="series-no">{no}</span>
                <span class="series-text">{titleKo}</span>
              </span>
            ) : (
              <a class="series-link" href={`${base}/blog/${p.id}`}>
                <span class="series-no">{no}</span>
                <span class="series-text">{titleKo}</span>
              </a>
            )}
          </li>
        );
      })}
    </ol>
  </aside>
)}

<style>
  /* 상자 없이 위아래 가는 선으로 묶는다 */
  .series-nav {
    margin: 1.5rem 0 2rem;
    padding: 1rem 0 1.1rem;
    border-top: 1px solid #d1d9e0;
    border-bottom: 1px solid #d1d9e0;
  }

  :global(.dark) .series-nav {
    border-color: #3d444d;
  }

  /* Header: title + progress count */
  .series-nav-head {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.75rem;
    margin-bottom: 0.6rem;
  }

  .series-nav-titlewrap {
    display: flex;
    align-items: center;
    gap: 0.45rem;
    min-width: 0;
  }

  .series-nav-icon {
    width: 15px;
    height: 15px;
    color: #1a6aa0;
    flex: none;
  }
  :global(.dark) .series-nav-icon { color: #8db8d0; }

  .series-nav-title {
    font-size: 14px;
    font-weight: 700;
    letter-spacing: -0.01em;
    color: #1f2328;
  }
  @media (min-width: 640px) { .series-nav-title { font-size: 15px; } }
  :global(.dark) .series-nav-title { color: #e5e7eb; }

  .series-nav-count {
    flex: none;
    font-size: 12px;
    font-weight: 600;
    color: #59636e;
    font-variant-numeric: tabular-nums;
    white-space: nowrap;
  }
  .series-nav-count-now { color: #1a6aa0; font-weight: 700; }
  .series-nav-count-sep { margin: 0 1px; }
  .series-nav-count-unit { margin-left: 2px; }
  :global(.dark) .series-nav-count { color: #9198a1; }
  :global(.dark) .series-nav-count-now { color: #8db8d0; }

  /* Numbered list — two columns to fill the width, column-wise fill */
  .series-nav-list {
    margin: 0;
    padding: 0;
    list-style: none;
    column-count: 1;
    column-gap: 1.75rem;
  }
  @media (min-width: 640px) {
    .series-nav-list { column-count: 2; }
  }

  .series-item {
    break-inside: avoid;
    margin: 0;
  }

  .series-link {
    display: flex;
    align-items: baseline;
    gap: 0.55rem;
    padding: 0.3rem 0;
    text-decoration: none;
    transition: background 0.2s ease, color 0.2s ease;
  }

  .series-no {
    flex: none;
    min-width: 1.5em;
    text-align: right;
    font-size: 0.78em;
    font-weight: 600;
    font-variant-numeric: tabular-nums;
    color: #59636e;
  }
  :global(.dark) .series-no { color: #9198a1; }

  .series-text {
    font-size: 13.5px;
    line-height: 1.55;
    color: #1f2328;
  }
  @media (min-width: 640px) { .series-text { font-size: 14px; } }
  :global(.dark) .series-text { color: #cbd5e1; }

  a.series-link:hover .series-text { color: #1a6aa0; }
  a.series-link:hover .series-no { color: #1a6aa0; }
  :global(.dark) a.series-link:hover .series-text { color: #8db8d0; }

  /* Current post — 굵게만 표시한다 */
  .is-current .series-link { cursor: default; }
  .is-current .series-no { color: #1a6aa0; font-weight: 700; }
  .is-current .series-text { color: #1f2328; font-weight: 700; }
  :global(.dark) .is-current .series-no { color: #8db8d0; }
  :global(.dark) .is-current .series-text { color: #f0f6fc; }
</style>
