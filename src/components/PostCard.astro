---
import { translateCategory } from '../lib/utils';
import { base, assetPath, getCategoryDisplayKo } from '../lib/config';

interface Props {
  title: string;
  description: string;
  date: Date;
  slug: string;
  tags?: string[];
  category?: string;
  coverImage?: string;
  index?: number;
  compact?: boolean;
}

const { title, description, date, slug, tags = [], category, coverImage: rawCoverImage, index = 0, compact = false } = Astro.props;
const coverImage = rawCoverImage || '/uploads/banners/default-post-cover.png';

const formattedDate = date.toLocaleDateString('ko-KR', {
  year: 'numeric',
  month: 'short',
  day: 'numeric',
});

const catDisplayKo = getCategoryDisplayKo();
const categoryKo = category ? translateCategory(category, catDisplayKo) : '';
---

<article class="group">
  <a href={`${base}/blog/${slug}`} class="flex flex-col glass-card rounded-xl sm:rounded-2xl overflow-hidden h-full">
    {/* Cover image */}
    <div class="px-4 pt-4 sm:px-5 sm:pt-5">
      <div class="thumb-frame aspect-[40/21] w-full rounded-xl relative overflow-hidden">
        {coverImage && (
          <img
            src={assetPath(coverImage)}
            alt=""
            class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-700 ease-out absolute inset-0"
            loading="lazy"
            onerror="this.style.display='none'"
          />
        )}
        <div class="w-full h-full flex items-center justify-center">
          <svg class="w-10 h-10 text-gray-300 dark:text-gray-600" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="0.8">
            <path stroke-linecap="round" stroke-linejoin="round" d="M4 16l4.586-4.586a2 2 0 012.828 0L16 16m-2-2l1.586-1.586a2 2 0 012.828 0L20 14m-6-6h.01M6 20h12a2 2 0 002-2V6a2 2 0 00-2-2H6a2 2 0 00-2 2v12a2 2 0 002 2z" />
          </svg>
        </div>
      </div>
    </div>

    {/* Content */}
    <div class="p-4 pt-3 sm:p-5 sm:pt-3.5 flex flex-col flex-1">
      <h3 class="text-[14px] sm:text-[15px] font-semibold leading-snug tracking-[-0.01em] group-hover:text-primary dark:group-hover:text-primary-light transition-colors duration-300 mb-1.5 line-clamp-2">
        {title}
      </h3>
      <p class="text-[12px] sm:text-[13px] text-gray-500 dark:text-gray-400 leading-relaxed line-clamp-3 mb-4">
        {description}
      </p>
      <div class="flex items-center gap-2 mt-auto flex-wrap">
        <time class="post-meta-badge date-badge">{formattedDate}</time>
        {category && (
          <span class="post-meta-badge category-badge">{categoryKo}</span>
        )}
      </div>
    </div>
  </a>
</article>
