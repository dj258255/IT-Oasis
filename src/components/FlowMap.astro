---
/**
 * BE-commerce 영역 흐름 지도. 허브(/projects/be-commerce)는 크게, 글 상단 시리즈 목록은
 * compact로 작게 같은 지도를 그린다. 동작은 src/lib/flow-map.ts의 initFlowMap이 붙인다.
 * 기본 슬롯은 지도 왼쪽 아래 빈 칸에 들어간다.
 */
export interface FlowTile {
  id: string;
  name: string;
  count: number;
  col: number;
  row: number;
  tagline?: string;
  modules?: string[];
  core?: boolean;
}

interface Props {
  tiles: FlowTile[];
  edges: { from: string; to: string; label: string }[];
  label: string;
  compact?: boolean;
  selected?: string | null;
  /** 지금 읽는 글이 속한 타일 */
  home?: string | null;
  /** 타일이 제어하는 목록의 id */
  controls?: string;
}

const { tiles, edges, label, compact = false, selected = null, home = null, controls } = Astro.props;
---

<div class:list={['flow-wrap', compact && 'flow-wrap--compact']}>
  <div class="flow-map" data-flow-map data-edges={JSON.stringify(edges)} role="group" aria-label={label}>
    <svg class="flow-lines" aria-hidden="true" data-flow-lines></svg>
    <span class="flow-dot" aria-hidden="true" data-flow-dot></span>

    <div class="flow-note"><slot /></div>

    {tiles.map((t) => (
      <button
        type="button"
        class:list={['node', t.core && 'node--core', t.id === selected && 'is-active', t.id === home && 'is-home']}
        style={`--col:${t.col};--row:${t.row}`}
        data-node={t.id}
        aria-pressed={t.id === selected ? 'true' : 'false'}
        aria-controls={controls}
      >
        <span class="node-name">{t.name}</span>
        {!compact && t.tagline && <span class="node-tagline">{t.tagline}</span>}
        {!compact && t.modules && (
          <span class="node-modules">{t.modules.map((m) => <code>{m}</code>)}</span>
        )}
        <span class:list={['node-count', t.count === 0 && 'node-count--empty']}>
          {t.count > 0 ? (compact ? `${t.count}편` : `글 ${t.count}편`) : (compact ? '준비 중' : '글 준비 중')}
          {t.id === home && <span class="node-here">읽는 중</span>}
        </span>
      </button>
    ))}
  </div>
</div>

<style>
  .flow-wrap {
    container-type: inline-size;
    --ink: #1f2a37;
    --muted: #6b7280;
    --line: #c7d3de;
    --lit: #4a8db8;
    --panel: #f5f8fb;
    --tile: #ffffff;
    --tile-border: #dbe4ec;
  }

  :global(.dark) .flow-wrap {
    --ink: #e5e9f0;
    --muted: #9aa5b4;
    --line: #3a4658;
    --lit: #8db8d0;
    --panel: #171b26;
    --tile: #1e2331;
    --tile-border: #2e3749;
  }

  .flow-map {
    position: relative;
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    grid-template-rows: auto auto;
    column-gap: clamp(4.5rem, 7cqi, 6rem);
    row-gap: 4.5rem;
    padding: clamp(1.5rem, 3cqi, 2.5rem);
    border-radius: 1.25rem;
    background-color: var(--panel);
    background-image: radial-gradient(circle at 1px 1px, rgba(74, 141, 184, 0.14) 1px, transparent 0);
    background-size: 22px 22px;
  }

  .flow-lines {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    pointer-events: none;
    overflow: visible;
  }

  .flow-lines :global(.edge path) {
    fill: none;
    stroke: var(--line);
    stroke-width: 1.5;
    stroke-dasharray: 4 5;
    transition: stroke 0.25s ease;
  }

  .flow-lines :global(.edge text) {
    font-size: 11px;
    font-weight: 600;
    fill: var(--muted);
    paint-order: stroke;
    stroke: var(--panel);
    stroke-width: 5px;
    stroke-linejoin: round;
    transition: fill 0.25s ease;
  }

  .flow-lines :global(.edge.is-lit path) {
    stroke: var(--lit);
    stroke-width: 2.25;
    stroke-dasharray: none;
  }

  .flow-lines :global(.edge.is-lit text) {
    fill: var(--lit);
  }

  .flow-dot {
    position: absolute;
    top: 0;
    left: 0;
    width: 12px;
    height: 12px;
    border-radius: 50%;
    background: var(--lit);
    box-shadow: 0 0 0 4px rgba(74, 141, 184, 0.22);
    offset-rotate: 0deg;
    offset-anchor: 50% 50%;
    opacity: 0;
    pointer-events: none;
    /* 타일(z-index 2) 아래로 지나가 타일에 들어갔다 나오는 것처럼 보인다 */
    z-index: 1;
  }

  .flow-dot.is-running {
    animation: travel 1.1s cubic-bezier(0.45, 0, 0.2, 1) forwards;
  }

  @keyframes travel {
    0% { offset-distance: 0%; opacity: 0; }
    8% { opacity: 1; }
    88% { opacity: 1; }
    100% { offset-distance: 100%; opacity: 0; }
  }

  .flow-note {
    grid-column: 1;
    grid-row: 2;
    align-self: center;
    margin: 0;
    font-size: 0.8125rem;
    line-height: 1.6;
    color: var(--muted);
    max-width: 14rem;
  }

  .flow-note :global(b) {
    color: var(--ink);
    font-weight: 700;
  }

  .node {
    position: relative;
    z-index: 2;
    grid-column: var(--col);
    grid-row: var(--row);
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 0.35rem;
    padding: 1rem 1.1rem;
    text-align: left;
    color: var(--ink);
    background: var(--tile);
    border: 1px solid var(--tile-border);
    border-radius: 0.875rem;
    cursor: pointer;
    transform-origin: 50% 60%;
    transition:
      transform 0.28s cubic-bezier(0.2, 0.8, 0.2, 1),
      box-shadow 0.28s ease,
      border-color 0.2s ease;
  }

  .node--core {
    border-width: 2px;
    border-color: var(--lit);
  }

  .node--core .node-name {
    font-size: 1.5rem;
  }

  .node:hover,
  .node:focus-visible {
    transform: scale(1.07);
    box-shadow: 0 18px 40px -18px rgba(31, 60, 90, 0.45);
    border-color: var(--lit);
    z-index: 4;
  }

  .node:focus-visible {
    outline: 3px solid var(--lit);
    outline-offset: 3px;
  }

  .node.is-on-route {
    border-color: var(--lit);
  }

  .node.is-active {
    background: var(--lit);
    border-color: var(--lit);
    color: #fff;
  }

  .node-name {
    font-size: 1.125rem;
    font-weight: 800;
    letter-spacing: -0.02em;
  }

  .node-tagline {
    font-size: 0.8125rem;
    color: var(--muted);
  }

  .node-modules {
    display: flex;
    flex-wrap: wrap;
    gap: 0.25rem;
    margin-top: 0.35rem;
    /* 자리는 늘 잡아 둔다. 펼치면 같은 줄 타일 높이가 바뀌어 지도가 출렁인다. */
    opacity: 0.5;
    transition: opacity 0.2s ease;
  }

  .node-modules code {
    font-family: var(--font-mono);
    font-size: 0.6875rem;
    padding: 0.1rem 0.35rem;
    border-radius: 0.3rem;
    background: rgba(74, 141, 184, 0.1);
  }

  .node:hover .node-modules,
  .node:focus-visible .node-modules,
  .node.is-active .node-modules {
    opacity: 1;
  }

  .node-count {
    display: flex;
    align-items: center;
    gap: 0.4rem;
    margin-top: auto;
    font-size: 0.75rem;
    font-weight: 700;
    color: var(--lit);
  }

  .node-count--empty {
    color: var(--muted);
    font-weight: 600;
  }

  .node-here {
    padding: 0.05rem 0.4rem;
    border-radius: 999px;
    font-size: 11px;
    font-weight: 700;
    color: var(--lit);
    background: rgba(74, 141, 184, 0.14);
  }

  .node.is-active .node-tagline,
  .node.is-active .node-count {
    color: rgba(255, 255, 255, 0.85);
  }

  .node.is-active .node-modules code,
  .node.is-active .node-here {
    color: #fff;
    background: rgba(255, 255, 255, 0.2);
  }

  /* ── compact: 글 상단 시리즈 목록 ─────────────── */
  /* 칸이 좁아 선 라벨은 숨긴다. 선과 점은 그대로 둔다. */

  .flow-wrap--compact .flow-map {
    column-gap: clamp(2rem, 5cqi, 3rem);
    row-gap: 2.25rem;
    padding: 1.25rem;
    border-radius: 1rem;
  }

  .flow-wrap--compact .flow-lines :global(.edge text) {
    display: none;
  }

  .flow-wrap--compact .node {
    gap: 0.2rem;
    padding: 0.7rem 0.85rem;
    border-radius: 0.75rem;
  }

  .flow-wrap--compact .node-name,
  .flow-wrap--compact .node--core .node-name {
    font-size: 15px;
  }

  .flow-wrap--compact .node:hover,
  .flow-wrap--compact .node:focus-visible {
    transform: scale(1.05);
  }

  .flow-wrap--compact .flow-note {
    font-size: 12.5px;
    max-width: none;
  }

  /* 지도가 놓인 칸이 좁으면 선을 접고 결제를 맨 앞에 둔 타일로 쌓는다. */
  @container (max-width: 820px) {
    .flow-wrap:not(.flow-wrap--compact) .flow-map {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 0.75rem;
    }
  }

  @container (max-width: 560px) {
    .flow-wrap--compact .flow-map {
      grid-template-columns: repeat(3, minmax(0, 1fr));
      gap: 0.6rem;
      padding: 0.9rem;
    }
  }

  @container (max-width: 820px) {
    .flow-wrap:not(.flow-wrap--compact) .flow-lines,
    .flow-wrap:not(.flow-wrap--compact) .flow-dot {
      display: none;
    }

    .flow-wrap:not(.flow-wrap--compact) .node {
      grid-column: auto;
      grid-row: auto;
    }

    .flow-wrap:not(.flow-wrap--compact) .node--core {
      grid-column: 1 / -1;
      order: -1;
    }

    .flow-wrap:not(.flow-wrap--compact) .flow-note {
      display: none;
    }
  }

  @container (max-width: 560px) {
    .flow-wrap--compact .flow-lines,
    .flow-wrap--compact .flow-dot {
      display: none;
    }

    .flow-wrap--compact .node {
      grid-column: auto;
      grid-row: auto;
    }

    .flow-wrap--compact .node--core {
      order: -1;
    }

    .flow-wrap--compact .node {
      padding: 0.6rem 0.7rem;
    }

    .flow-wrap--compact .node-name,
    .flow-wrap--compact .node--core .node-name {
      font-size: 13.5px;
      white-space: nowrap;
    }

    /* 타일이 좁아 줄이 깨진다. 지금 위치는 채워진 타일과 아래 문장이 알려 준다. */
    .flow-wrap--compact .node-here {
      display: none;
    }

    .flow-wrap--compact .flow-note {
      grid-column: 1 / -1;
      grid-row: auto;
      order: 10;
    }
  }

  /* 아주 좁으면 3열에서도 영역 이름이 한 줄에 안 들어가 2열로 쌓는다. */
  @container (max-width: 420px) {
    .flow-wrap--compact .flow-map {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .node,
    .node-modules,
    .flow-lines :global(.edge path),
    .flow-lines :global(.edge text) {
      transition: none;
    }

    .node:hover,
    .node:focus-visible {
      transform: none;
    }

    .flow-dot {
      display: none;
    }
  }
</style>
