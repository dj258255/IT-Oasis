---
/**
 * 허브가 있는 시리즈(BE-commerce)의 글 상단 목록.
 * 번호순 목록 대신 허브와 같은 흐름 지도를 작게 두고, 고른 영역의 글만 아래에 보여 준다.
 * 처음에는 지금 읽는 글이 속한 영역이 열린다. 개요 글처럼 영역이 없으면 코어(결제)가 열린다.
 */
import FlowMap from './FlowMap.astro';
import { getPublishedPosts } from '../lib/posts';
import { base } from '../lib/config';
import { hubDomains, hubEdges, HUB_PATH, HUB_SERIES } from '../data/be-commerce-hub';

interface Props {
  currentPostId: string;
}

const { currentPostId } = Astro.props;
// 시리즈 이름으로 거르지 않고 허브 매핑을 그대로 따른다. 다른 시리즈에 속한 글(ch6)도
// 허브 영역에 있으면 여기서도 같은 영역에 보여야 허브와 숫자가 맞는다.
const published = new Map((await getPublishedPosts()).map((p) => [p.id, p]));

const domains = hubDomains.map((d) => ({
  ...d,
  entries: d.posts
    .map((id) => published.get(id))
    .filter((p): p is NonNullable<typeof p> => Boolean(p))
    .sort((a, b) => (a.data.seriesOrder ?? 999) - (b.data.seriesOrder ?? 999)),
}));

const home = domains.find((d) => d.entries.some((p) => p.id === currentPostId));
const openId = home?.id ?? domains.find((d) => d.core)?.id ?? domains[0].id;
const position = home ? home.entries.findIndex((p) => p.id === currentPostId) + 1 : 0;
const total = domains.reduce((n, d) => n + d.entries.length, 0);
const tiles = domains.map((d) => ({ ...d, count: d.entries.length }));

---

<aside class="hsn" data-hsn aria-label={`${HUB_SERIES} 시리즈 영역별 목록`}>
  <div class="hsn-head">
    <strong class="hsn-title">{HUB_SERIES} 시리즈</strong>
    <a class="hsn-home" href={`${base}${HUB_PATH}`}>프로젝트 홈</a>
  </div>

  <FlowMap tiles={tiles} edges={hubEdges} label="BE-commerce 영역 지도" compact selected={openId} home={home?.id ?? null} controls="hsn-lists">
    {home
      ? <>지금 <b>{home.name}</b> 영역의 {position}번째 글을 읽고 있습니다. 전체 {total}편입니다.</>
      : <>영역을 고르면 그 영역의 글이 아래에 나옵니다. 전체 {total}편입니다.</>}
  </FlowMap>

  <div id="hsn-lists" class="hsn-lists">
    <div class="tank-fx" aria-hidden="true">
      <span class="caustics"></span>
      <svg class="fish fish--a" viewBox="0 0 64 32"><path d="M3 16 C 12 5, 34 5, 44 16 C 34 27, 12 27, 3 16 Z M42 16 L60 6 L55 16 L60 26 Z" /></svg>
      <svg class="fish fish--b" viewBox="0 0 64 32"><path d="M3 16 C 12 5, 34 5, 44 16 C 34 27, 12 27, 3 16 Z M42 16 L60 6 L55 16 L60 26 Z" /></svg>
      <div class="bubbles" data-bubbles></div>
    </div>
    {domains.map((d) => (
      <section class="hsn-list" data-hsn-list={d.id} hidden={d.id !== openId} aria-label={`${d.name} 영역의 글`}>
        <div class="hsn-list-head">
          <h2 class="hsn-list-name">{d.name}</h2>
          <span class="hsn-list-count">{d.entries.length > 0 ? `${d.entries.length}편` : '준비 중'}</span>
        </div>
        <p class="hsn-list-summary">{d.summary}</p>
        {d.entries.length > 0 ? (
          <ol>
            {d.entries.map((p, i) => (
              <li class:list={[p.id === currentPostId && 'is-current']}>
                <span class="hsn-no">{i + 1}.</span>
                {p.id === currentPostId
                  ? <span class="hsn-title-text" aria-current="page">{p.data.title}</span>
                  : <a class="hsn-title-text" href={`${base}/blog/${p.id}`}>{p.data.title}</a>}
              </li>
            ))}
          </ol>
        ) : (
          <p class="hsn-empty">
            이 영역의 글은 아직 없습니다. <a href={d.doc.url} target="_blank" rel="noopener noreferrer">{d.doc.label}</a> 문서에서 먼저 볼 수 있습니다.
          </p>
        )}
      </section>
    ))}
  </div>
</aside>

<script>
  import { initFlowMap } from '../lib/flow-map';
  import { startBubbles } from '../lib/aquarium';

  let hsnController: AbortController | null = null;

  function initHubSeriesNav() {
    const root = document.querySelector<HTMLElement>('[data-hsn]');
    const map = root?.querySelector<HTMLElement>('[data-flow-map]');
    if (!root || !map) return;
    hsnController?.abort();
    hsnController = new AbortController();

    const lists = Array.from(root.querySelectorAll<HTMLElement>('[data-hsn-list]'));
    const bubbles = root.querySelector<HTMLElement>('[data-bubbles]');
    if (bubbles) startBubbles(bubbles, hsnController.signal);

    initFlowMap(map, {
      signal: hsnController.signal,
      onSelect: (id) => {
        lists.forEach((l) => { l.hidden = l.dataset.hsnList !== id; });
      },
    });
  }

  initHubSeriesNav();
  document.addEventListener('astro:page-load', initHubSeriesNav);
</script>

<style>
  .hsn {
    --ink: #1f2a37;
    --muted: #6b7280;
    --lit: #4a8db8;
    margin: 1.5rem 0 2rem;
    padding: 1.25rem;
    border-radius: 1.25rem;
    background: linear-gradient(150deg, rgba(255, 255, 255, 0.86) 0%, rgba(236, 246, 255, 0.62) 100%);
    backdrop-filter: blur(22px) saturate(170%);
    -webkit-backdrop-filter: blur(22px) saturate(170%);
    border: 1px solid rgba(15, 40, 80, 0.08);
    box-shadow: 0 8px 28px rgba(15, 40, 80, 0.06), 0 1px 3px rgba(15, 40, 80, 0.05);
  }

  :global(.dark) .hsn {
    --ink: #e5e9f0;
    --muted: #9aa5b4;
    --lit: #8db8d0;
    background: linear-gradient(150deg, rgba(255, 255, 255, 0.07) 0%, rgba(80, 140, 200, 0.045) 100%);
    border-color: rgba(255, 255, 255, 0.1);
    box-shadow: 0 8px 28px rgba(0, 0, 0, 0.28);
  }

  @media (min-width: 640px) {
    .hsn { padding: 1.4rem 1.6rem 1.5rem; }
  }

  .hsn-head {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    margin-bottom: 1rem;
  }

  .hsn-title {
    font-size: 16px;
    font-weight: 800;
    letter-spacing: -0.015em;
    color: var(--ink);
  }

  .hsn-home {
    flex: none;
    padding: 0.4rem 0.85rem;
    border: 1px solid rgba(74, 141, 184, 0.3);
    border-radius: 999px;
    font-size: 13px;
    font-weight: 700;
    color: var(--lit);
    text-decoration: none;
    transition: background-color 0.2s ease;
  }

  .hsn-home:hover { background: rgba(74, 141, 184, 0.1); }

  .hsn-home:focus-visible {
    outline: 3px solid var(--lit);
    outline-offset: 2px;
  }

  /* ── 고른 영역의 글 ─────────────────────── */

  /* 수조: 아래로 갈수록 물빛이 짙어지고, 물결빛·물고기·기포는 글 뒤에 깔린다 */
  .hsn-lists {
    --water-top: #eef8fd;
    --water-mid: #d8eef8;
    --water-deep: #c3e3f2;
    --glass: rgba(74, 141, 184, 0.2);
    --rule: rgba(40, 110, 150, 0.16);
    --fish: #2f7fae;
    position: relative;
    isolation: isolate;
    overflow: hidden;
    margin-top: 1.5rem;
    padding: 1.4rem 1.4rem 1.6rem;
    border-radius: 1rem;
    border: 1px solid var(--glass);
    background: linear-gradient(180deg, var(--water-top) 0%, var(--water-mid) 55%, var(--water-deep) 100%);
    box-shadow:
      inset 0 1px 0 rgba(255, 255, 255, 0.85),
      inset 0 -24px 48px rgba(30, 110, 160, 0.08);
  }

  :global(.dark) .hsn-lists {
    --water-top: #12314a;
    --water-mid: #0d2638;
    --water-deep: #081a29;
    --glass: rgba(141, 184, 208, 0.18);
    --rule: rgba(141, 200, 230, 0.14);
    --fish: #8fd0f5;
    --muted: #a9bccb;
    box-shadow:
      inset 0 1px 0 rgba(255, 255, 255, 0.08),
      inset 0 -24px 48px rgba(0, 0, 0, 0.25);
  }

  .hsn-lists > :not(.tank-fx) {
    position: relative;
    z-index: 2;
  }

  .tank-fx {
    position: absolute;
    inset: 0;
    z-index: 0;
    pointer-events: none;
  }

  /* 수면에서 내려오는 물결빛. 두 겹의 무늬가 서로 다른 속도로 흘러 일렁인다. */
  .caustics {
    position: absolute;
    inset: -40% -10% 30%;
    background:
      radial-gradient(ellipse 60px 24px at 20% 30%, rgba(255, 255, 255, 0.55), transparent 70%),
      radial-gradient(ellipse 80px 30px at 70% 20%, rgba(255, 255, 255, 0.45), transparent 70%),
      radial-gradient(ellipse 50px 20px at 45% 60%, rgba(255, 255, 255, 0.4), transparent 70%);
    background-size: 260px 140px, 340px 170px, 220px 120px;
    mix-blend-mode: soft-light;
    opacity: 0.9;
    animation: shimmer 18s linear infinite;
    mask-image: linear-gradient(180deg, #000 0%, transparent 100%);
  }

  :global(.dark) .caustics {
    mix-blend-mode: screen;
    opacity: 0.18;
  }

  @keyframes shimmer {
    from { background-position: 0 0, 0 0, 0 0; }
    to { background-position: 260px 40px, -340px 30px, 220px -20px; }
  }

  .fish {
    position: absolute;
    left: 0;
    width: 46px;
    height: 23px;
    fill: var(--fish);
    opacity: 0.14;
  }

  :global(.dark) .fish { opacity: 0.2; }

  .fish--a {
    top: 38%;
    animation: swim-right 46s linear infinite, bob 5s ease-in-out infinite;
  }

  .fish--b {
    top: 72%;
    width: 32px;
    height: 16px;
    animation: swim-left 62s linear infinite -20s, bob 6.5s ease-in-out infinite;
  }

  @keyframes swim-right {
    from { translate: -60px 0; scale: 1 1; }
    to { translate: calc(100cqw + 60px) 0; scale: 1 1; }
  }

  @keyframes swim-left {
    from { translate: calc(100cqw + 60px) 0; scale: -1 1; }
    to { translate: -60px 0; scale: -1 1; }
  }

  @keyframes bob {
    0%, 100% { margin-top: 0; }
    50% { margin-top: -6px; }
  }

  .tank-fx { container-type: inline-size; }

  .bubbles {
    position: absolute;
    inset: 0;
    z-index: 1;
  }

  @media (prefers-reduced-motion: reduce) {
    .caustics, .fish { animation: none; }
    .fish--a { translate: 30cqw 0; }
    .fish--b { translate: 70cqw 0; scale: -1 1; }
  }

  .hsn-list[hidden] { display: none; }

  .hsn-list-head {
    display: flex;
    align-items: baseline;
    gap: 0.6rem;
    margin-bottom: 0.35rem;
  }

  .hsn-list-name {
    margin: 0;
    font-size: 19px;
    font-weight: 800;
    letter-spacing: -0.02em;
    color: var(--ink);
  }

  .hsn-list-count {
    font-size: 13px;
    font-weight: 700;
    color: var(--lit);
  }

  .hsn-list-summary {
    margin: 0 0 0.75rem;
    font-size: 14px;
    line-height: 1.7;
    color: var(--muted);
  }

  .hsn-list ol {
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .hsn-list li {
    display: flex;
    align-items: baseline;
    gap: 0.5rem;
    padding: 0.65rem 0;
    border-bottom: 1px solid var(--rule);
    font-size: 15px;
    line-height: 1.6;
  }

  .hsn-list li:first-child { border-top: 1px solid var(--rule); }

  .hsn-no {
    flex: none;
    min-width: 1.6rem;
    text-align: right;
    color: var(--muted);
    font-variant-numeric: tabular-nums;
  }

  .hsn-title-text {
    color: var(--ink);
    text-decoration: none;
  }

  a.hsn-title-text:hover {
    color: var(--lit);
    text-decoration: underline;
    text-underline-offset: 3px;
  }

  .is-current .hsn-title-text {
    font-weight: 700;
  }

  .hsn-empty {
    margin: 0;
    padding: 1rem 1.1rem;
    border: 1px dashed rgba(74, 141, 184, 0.35);
    border-radius: 0.75rem;
    font-size: 14px;
    color: var(--muted);
  }

  .hsn-empty a { color: var(--lit); font-weight: 600; }

</style>
