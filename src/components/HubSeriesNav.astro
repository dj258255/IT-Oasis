---
/**
 * 허브가 있는 시리즈(BE-commerce)의 글 상단 목록.
 * 번호순 목록 대신 허브와 같은 흐름 지도를 작게 두고, 고른 영역의 글만 아래에 보여 준다.
 * 처음에는 지금 읽는 글이 속한 영역이 열린다. 개요 글처럼 영역이 없으면 코어(결제)가 열린다.
 */
import FlowMap from './FlowMap.astro';
import { getPublishedPosts } from '../lib/posts';
import { base } from '../lib/config';
import { hubDomains, hubEdges, HUB_PATH, HUB_SERIES } from '../data/be-commerce-hub';

interface Props {
  currentPostId: string;
}

const { currentPostId } = Astro.props;
// 시리즈 이름으로 거르지 않고 허브 매핑을 그대로 따른다. 다른 시리즈에 속한 글(ch6)도
// 허브 영역에 있으면 여기서도 같은 영역에 보여야 허브와 숫자가 맞는다.
const published = new Map((await getPublishedPosts()).map((p) => [p.id, p]));

const domains = hubDomains.map((d) => ({
  ...d,
  entries: d.posts
    .map((id) => published.get(id))
    .filter((p): p is NonNullable<typeof p> => Boolean(p))
    .sort((a, b) => (a.data.seriesOrder ?? 999) - (b.data.seriesOrder ?? 999)),
}));

const home = domains.find((d) => d.entries.some((p) => p.id === currentPostId));
const openId = home?.id ?? domains.find((d) => d.core)?.id ?? domains[0].id;
const position = home ? home.entries.findIndex((p) => p.id === currentPostId) + 1 : 0;
const total = domains.reduce((n, d) => n + d.entries.length, 0);
const tiles = domains.map((d) => ({ ...d, count: d.entries.length }));

---

<aside class="hsn" data-hsn aria-label={`${HUB_SERIES} 시리즈 영역별 목록`}>
  <div class="hsn-head">
    <strong class="hsn-title">{HUB_SERIES} 시리즈</strong>
    <a class="hsn-home" href={`${base}${HUB_PATH}`}>프로젝트 홈</a>
  </div>

  <FlowMap tiles={tiles} edges={hubEdges} label="BE-commerce 영역 지도" compact selected={openId} home={home?.id ?? null} controls="hsn-lists">
    {home
      ? <>지금 <b>{home.name}</b> 영역의 {position}번째 글을 읽고 있습니다. 전체 {total}편입니다.</>
      : <>영역을 고르면 그 영역의 글이 아래에 나옵니다. 전체 {total}편입니다.</>}
  </FlowMap>

  <div id="hsn-lists" class="hsn-lists">
    {domains.map((d) => (
      <section class="hsn-list" data-hsn-list={d.id} hidden={d.id !== openId} aria-label={`${d.name} 영역의 글`}>
        <div class="hsn-list-head">
          <h2 class="hsn-list-name">{d.name}</h2>
          <span class="hsn-list-count">{d.entries.length > 0 ? `${d.entries.length}편` : '준비 중'}</span>
        </div>
        <p class="hsn-list-summary">{d.summary}</p>
        {d.entries.length > 0 ? (
          <ol>
            {d.entries.map((p, i) => (
              <li class:list={[p.id === currentPostId && 'is-current']}>
                <span class="hsn-no">{i + 1}</span>
                {p.id === currentPostId
                  ? <span class="hsn-title-text" aria-current="page">{p.data.title}</span>
                  : <a class="hsn-title-text" href={`${base}/blog/${p.id}`}>{p.data.title}</a>}
              </li>
            ))}
          </ol>
        ) : (
          <p class="hsn-empty">
            이 영역의 글은 아직 없습니다. <a href={d.doc.url} target="_blank" rel="noopener noreferrer">{d.doc.label}</a> 문서에서 먼저 볼 수 있습니다.
          </p>
        )}
      </section>
    ))}
  </div>
</aside>

<script>
  import { initFlowMap } from '../lib/flow-map';

  let hsnController: AbortController | null = null;

  function initHubSeriesNav() {
    const root = document.querySelector<HTMLElement>('[data-hsn]');
    const map = root?.querySelector<HTMLElement>('[data-flow-map]');
    if (!root || !map) return;
    hsnController?.abort();
    hsnController = new AbortController();

    const lists = Array.from(root.querySelectorAll<HTMLElement>('[data-hsn-list]'));
    initFlowMap(map, {
      signal: hsnController.signal,
      onSelect: (id) => {
        lists.forEach((l) => { l.hidden = l.dataset.hsnList !== id; });
      },
    });
  }

  initHubSeriesNav();
  document.addEventListener('astro:page-load', initHubSeriesNav);
</script>

<style>
  .hsn {
    --ink: #1f2328;
    --muted: #59636e;
    --lit: #1a6aa0;
    --rule: rgba(15, 40, 80, 0.1);
    margin: 1.5rem 0 2rem;
    padding: 1.25rem;
    border-radius: 1.25rem;
    background: linear-gradient(150deg, rgba(255, 255, 255, 0.86) 0%, rgba(236, 246, 255, 0.62) 100%);
    backdrop-filter: blur(22px) saturate(170%);
    -webkit-backdrop-filter: blur(22px) saturate(170%);
    border: 1px solid rgba(15, 40, 80, 0.08);
    box-shadow: 0 8px 28px rgba(15, 40, 80, 0.06), 0 1px 3px rgba(15, 40, 80, 0.05);
  }

  :global(.dark) .hsn {
    --ink: #e6edf3;
    --muted: #9198a1;
    --lit: #8db8d0;
    --rule: rgba(255, 255, 255, 0.1);
    background: linear-gradient(150deg, rgba(255, 255, 255, 0.07) 0%, rgba(80, 140, 200, 0.045) 100%);
    border-color: rgba(255, 255, 255, 0.1);
    box-shadow: 0 8px 28px rgba(0, 0, 0, 0.28);
  }

  @media (min-width: 640px) {
    .hsn { padding: 1.4rem 1.6rem 1.5rem; }
  }

  .hsn-head {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    margin-bottom: 1rem;
  }

  .hsn-title {
    font-size: 16px;
    font-weight: 800;
    letter-spacing: -0.015em;
    color: var(--ink);
  }

  .hsn-home {
    flex: none;
    padding: 0.4rem 0.85rem;
    border: 1px solid rgba(74, 141, 184, 0.3);
    border-radius: 999px;
    font-size: 13px;
    font-weight: 700;
    color: var(--lit);
    text-decoration: none;
    transition: background-color 0.2s ease;
  }

  .hsn-home:hover { background: rgba(74, 141, 184, 0.1); }

  .hsn-home:focus-visible {
    outline: 3px solid var(--lit);
    outline-offset: 2px;
  }

  /* ── 고른 영역의 글 ─────────────────────── */

  .hsn-lists { margin-top: 1.5rem; }

  .hsn-list[hidden] { display: none; }

  .hsn-list-head {
    display: flex;
    align-items: baseline;
    gap: 0.6rem;
    margin-bottom: 0.4rem;
  }

  .hsn-list-name {
    margin: 0;
    font-size: 20px;
    font-weight: 700;
    letter-spacing: -0.02em;
    color: var(--ink);
  }

  .hsn-list-count {
    font-size: 14px;
    font-weight: 500;
    color: var(--muted);
  }

  /* 한국어는 기본값에서 단어 중간에서도 줄이 바뀐다. 단어 단위로 끊고 마지막 줄에
     한두 글자만 남지 않게 한다. */
  .hsn-list-summary,
  .hsn-title-text {
    word-break: keep-all;
    text-wrap: pretty;
  }

  .hsn-list-summary {
    margin: 0 0 1.1rem;
    font-size: 15px;
    line-height: 1.65;
    color: var(--muted);
  }

  /* 기술 블로그 시리즈 목차: 글마다 가는 선, 옅은 번호, 넉넉한 행 간격 */
  .hsn-list ol {
    list-style: none;
    margin: 0;
    padding: 0;
    border-bottom: 1px solid var(--rule);
  }

  .hsn-list li {
    display: grid;
    grid-template-columns: 2.25rem 1fr;
    align-items: baseline;
    padding: 0.9rem 0;
    border-top: 1px solid var(--rule);
  }

  .hsn-no {
    font-size: 14px;
    font-weight: 500;
    color: var(--muted);
    font-variant-numeric: tabular-nums;
  }

  .hsn-title-text {
    font-size: 16px;
    font-weight: 500;
    line-height: 1.5;
    color: var(--ink);
    text-decoration: none;
  }

  a.hsn-title-text:hover {
    text-decoration: underline;
    text-decoration-thickness: 1px;
    text-underline-offset: 4px;
  }

  a.hsn-title-text:focus-visible {
    outline: 2px solid var(--lit);
    outline-offset: 3px;
    border-radius: 2px;
  }

  .is-current .hsn-no { color: var(--lit); font-weight: 700; }
  .is-current .hsn-title-text { font-weight: 700; }

  .hsn-empty {
    margin: 0;
    padding: 1rem 1.1rem;
    border: 1px dashed rgba(74, 141, 184, 0.35);
    border-radius: 0.75rem;
    font-size: 14px;
    color: var(--muted);
  }

  .hsn-empty a { color: var(--lit); font-weight: 600; }

</style>
